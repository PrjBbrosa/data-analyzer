{
  "schema_version": 1,
  "policy": {
    "never_claim_full_coverage_from_focused": true,
    "unmapped_defaults": "coordinator-inspect",
    "wide_infra_requires_integration_gate": true,
    "preserve_collector_identity_repair": true,
    "do_not_freeze_argument_order_to_hide_fixture_loss": true,
    "no_scan_cache_across_mutations": true,
    "focused_pass_is_not_full_pass": true,
    "first_version_owners_only": [
      "signal",
      "io",
      "batch",
      "pin",
      "view",
      "canvas",
      "acquisition",
      "ui_kit",
      "selector"
    ]
  },
  "acceptance_sets": {
    "focused": {
      "when": "Every related code change. Owner tests plus the explicit boundary tests named by the matching route.",
      "command": "{python} -m pytest {nodes} -q",
      "result_scope": "PASS applies only to the selected nodes. It is not a full-integration PASS."
    },
    "full_integration": {
      "when": "Stable milestone, merge/release, or a wide conftest/pytest-config change after infra regressions.",
      "note": "Default suite still inherits pytest.ini addopts -m 'not slow'. Main and acquisition_ui are sequential fresh processes. One coordinator. Do not overlap another pytest in this checkout.",
      "commands": [
        "{python} scripts/run_test_gate.py --full-suite",
        "{python} -m pytest --ignore=tests/acquisition_ui",
        "{python} -m pytest tests/acquisition_ui"
      ],
      "result_scope": "PASS is the default (non-slow) integration set only. It is not slow, real-file, native, Cocoa, or Windows frozen acceptance."
    },
    "slow": {
      "when": "Performance contract changes or the scheduled performance acceptance.",
      "command": "{python} -m pytest -m slow -o addopts=",
      "note": "pytest.ini defaults to not slow. Override addopts so -m slow is not AND-ed with not slow. Keep every existing slow node; do not shrink the set to look faster.",
      "known_nodes": [
        "tests/perf/test_timedomain_pan_perf.py",
        "tests/ui/test_pg_timedomain_canvas.py (slow-marked items only)"
      ]
    },
    "real_file": {
      "when": "Format/loader/algorithm changes that the real-sample contract covers, and release acceptance that needs those samples.",
      "command": "{python} -m pytest tests/integration/test_head_hdf_realfile.py tests/integration/test_t08_order_cot_e2e.py -q",
      "nodes": [
        "tests/integration/test_head_hdf_realfile.py",
        "tests/integration/test_t08_order_cot_e2e.py"
      ],
      "result_scope": "Missing samples make that item unverified. Do not treat focused or default full PASS as real-file PASS."
    },
    "native": {
      "when": "Native import/runtime modules change, or a release that claims native Vector/XCP/Windows runtime.",
      "command": "{python} -m pytest tests/test_native_import_boundaries.py tests/test_windows_runtime_dependencies.py tests/test_windows_runtime_verifier.py -q",
      "nodes": [
        "tests/test_native_import_boundaries.py",
        "tests/test_windows_runtime_dependencies.py",
        "tests/test_windows_runtime_verifier.py",
        "tests/test_p0_a2l_probe_import_safety.py"
      ]
    },
    "frozen": {
      "when": "Packaging, hidden imports, Windows build scripts, or frozen Batch/render smoke.",
      "command": "{python} -m pytest tests/test_packaging_imports.py tests/test_windows_build_script.py tests/test_frozen_batch_acceptance.py tests/test_frozen_batch_render_smoke.py -q",
      "nodes": [
        "tests/test_packaging_imports.py",
        "tests/test_windows_build_script.py",
        "tests/test_frozen_batch_acceptance.py",
        "tests/test_frozen_batch_render_smoke.py",
        "tests/test_verify_ultraview_visuals.py"
      ]
    }
  },
  "infra": {
    "pytest_config": [
      "pytest.ini",
      "conftest.py"
    ],
    "conftest": [
      "conftest.py",
      "tests/conftest.py",
      "tests/ui/conftest.py",
      "tests/acquisition_ui/conftest.py"
    ],
    "shared_helpers": [
      "tests/conftest.py",
      "tests/ui/conftest.py",
      "tests/acquisition_ui/conftest.py"
    ],
    "required_nodes": [
      "tests/test_conftest_autouse_scope.py"
    ],
    "infra_regressions": [
      "tests/test_conftest_autouse_scope.py",
      "tests/ui/test_qsettings_isolation.py",
      "tests/ui/test_app_style_isolation.py",
      "tests/ui/test_qt_fixture_lifecycle.py"
    ],
    "requires_stable_integration_gate": true,
    "note": "Wide fixture/config changes run infra regressions first, then a coordinator-owned stable integration gate. Do not default to all tests or to an empty set. tests/test_conftest_autouse_scope.py stays the collector-identity repair gate; do not freeze pytest argument order to hide fixture loss."
  },
  "selector": {
    "id": "selector",
    "source_paths": [
      "scripts/select_test_gate.py",
      "scripts/test_gate_routes.json"
    ],
    "owner_tests": [
