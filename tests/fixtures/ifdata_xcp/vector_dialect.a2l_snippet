/begin IF_DATA XCP
  /begin PROTOCOL_LAYER
    0x0100
    100 100 100 100 100 100 100
    8 8
    BYTE_ORDER_MSB_LAST
    ADDRESS_GRANULARITY_BYTE
  /end PROTOCOL_LAYER
  /begin DAQ
    DYNAMIC 0 1 0
    GRANULARITY_ODT_ENTRY_SIZE_DAQ_BYTE
    8
    OVERLOAD_INDICATION_EVENT
    /begin TIMESTAMP_SUPPORTED
      0x0002 SIZE_WORD UNIT_1US DAQ_TIMESTAMP_FIXED_LENGTH
    /end TIMESTAMP_SUPPORTED
    /begin EVENT "5ms" "5ms" 0 DAQ 8 5 6 0 /end EVENT
  /end DAQ
  /begin XCP_ON_CAN
    0x0100
    CAN_ID_CMD 0x650
    CAN_ID_RES 0x651
    BAUDRATE 500000
  /end XCP_ON_CAN
/end IF_DATA
