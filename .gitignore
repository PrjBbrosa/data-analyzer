# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
.venv-build-win/
.build-tools/
venv/
env/

# Test / coverage
.pytest_cache/
.pytest-tmp/
.pytest_tmp*/
.pytmp/
.coverage
htmlcov/
.tox/

# Stray npm lockfile (this is a Python project; no Node deps)
package-lock.json

# IDE
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# Local Claude / superpowers state
.claude/
.superpowers/
.worktrees/

# Local Codex state
.state/

# Root-level local planning state retained outside version control.
/findings.md
/progress.md
/task_plan.md

# Local sample data (not part of the repo's own tests)
testdoc/
testfile/

# WWT open-trial candidates: generated from testdoc measurements by
# tools/matlab_ports/emit_wwt_*.py — reproducible, and they carry customer data.
tools/matlab_ports/wwt_export_candidates/*.wwt

# Local secrets / dotenv
.env
.env.*

# Backup of pre-restore orphan repo (kept locally for safety)
.git.local-orphan/

# Local acquisition datasets and private manifests
data/local/
data/manifest.local.json
data/snapshots/*.golden.json

# Local-only signal mappings; example files are tracked.
configs/signals/vehicles/*.json
!configs/signals/vehicles/*.example.json

# Local render / tour / review artifacts (screenshots, offscreen probes,
# codex review dumps) — regenerated on demand, not part of the repo.
output/
codex-review-report.html

# Playwright CLI runtime artifacts (console logs, page snapshots,
# screenshots) — regenerated on demand, never part of the repo.
.playwright-cli/
