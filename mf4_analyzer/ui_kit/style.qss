/* ==== MF4 Analyzer — Precision Light visual system ====
 * Palette (3 neutral surfaces + 1 interaction blue)
 *   surface-base    #f5f7fb   window, side panes, status bar
 *   surface-card    #ffffff   cards, inputs, tree, menus, toolbar
 *   surface-hover   #eef2f7   hover / pressed on plain controls
 *   surface-accent  #e8efff   checked / selected blue
 * Hairline borders
 *   hairline        #eef2f7   dividers, card edges (1% contrast)
 *   hairline-strong #dfe5ee   group containers that still need a visible frame
 * Text / hierarchy — by size + weight only, no background fills:
 *   pane / card title  13px / 700   #111827
 *   body               12px / 400   #111827
 *   caption / meta     11px / 600   #64748b
 *   numeric badge      11px / 600   #475569  (no fill)
 */

QMainWindow,
QWidget {
    background-color: #f5f7fb;
    color: #111827;
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", "SF Pro Text", sans-serif;
    font-size: 12px;
}

QWidget:disabled {
    color: #94a3b8;
}

QFrame,
QGroupBox {
    background-color: #ffffff;
}

/* QLabel inherits QFrame, so strip the default white fill — labels live
 * inline on whatever surface contains them. */
QLabel {
    background-color: transparent;
}

/* Splitter — subtle */
QSplitter::handle { margin: 0; background-color: #eef2f7; }
QSplitter::handle:horizontal { width: 3px; margin: 0; }
QSplitter::handle:vertical { height: 3px; margin: 0; }
QSplitter::handle:hover { background-color: #cbd5e1; }

/* Scroll areas */
QScrollArea { border: none; background: transparent; }

QScrollBar:vertical { width: 10px; margin: 2px; border: none; background: transparent; }
QScrollBar::handle:vertical { min-height: 28px; border-radius: 5px; background: #cbd5e1; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { height: 0; background: transparent; }

QScrollBar:horizontal { height: 10px; margin: 2px; border: none; background: transparent; }
QScrollBar::handle:horizontal { min-width: 28px; border-radius: 5px; background: #cbd5e1; }
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { width: 0; background: transparent; }

/* Inputs */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 24px;
    padding: 3px 8px;
    border: 1px solid #dfe5ee;
    border-radius: 7px;
    background-color: #ffffff;
    selection-background-color: #1769e0;
    selection-color: #ffffff;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover { border-color: #b7c4d3; }
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus { border-color: #1769e0; }
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #94a3b8;
    background-color: #f5f7fb;
    border-color: #eef2f7;
}

/* Combo / spin button regions — provide a faint resting tint so the
 * click target is discoverable without hover, plus explicit arrow
 * glyphs sourced from qtawesome (mdi6.menu-up / mdi6.menu-down) and
 * cached as PNG files under ~/.mf4-analyzer-cache/icons. The
 * placeholders below are substituted at startup by
 * mf4_analyzer.ui.icons.render_qss_template (see app.py loader). See
 * lesson pyqt-ui/2026-04-28-qss-subcontrol-needs-explicit-arrow-glyph.md.
 *
 * Why image:url and not the border-triangle CSS hack: the triangle
 * width is fixed by the border math, so it does not visually scale
 * with the gutter button; HiDPI also amplifies its blocky edge. A
 * vector glyph rasterized to the screen DPR keeps the chevron crisp
 * across scale factors and aligns naturally inside the 22px gutter.
 */
QComboBox::drop-down {
    width: 22px;
    border: none;
    border-left: 1px solid #eef2f7;
    background-color: #fafbfd;
}
QComboBox::drop-down:hover { background-color: #eef2f7; }
QComboBox::drop-down:pressed { background-color: #d8e4f5; }
QComboBox::down-arrow {
    image: url("{{ICON_COMBO_DOWN_REST}}");
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:on,
QComboBox::down-arrow:hover {
    image: url("{{ICON_COMBO_DOWN_HOVER}}");
}
QComboBox::down-arrow:disabled {
    image: url("{{ICON_COMBO_DOWN_DISABLED}}");
}

/* Spin boxes that opt-in via ``setProperty('compact', True)`` are
 * rendered as plain editable text fields — the right-gutter stepper
 * buttons were removed (2026-04-29). Users interact via keyboard /
 * scroll wheel only, so we reclaim the previous 24 px right padding
 * back to the symmetric 8 px used on every other side. Long-form
 * ``padding-left`` / ``padding-right`` so the global cascade keeps the
 * top/bottom values from the rule above (see lesson
 * pyqt-ui/2026-04-27-qss-padding-overrides-setcontentsmargins.md).
 *
 * The selectors below are scoped to ``[compact="true"]`` (P8-O1, Wave
 * 5) so any future widget that wants the native stepper — e.g. a
 * third-party dialog or a debug panel — can simply omit the property
 * and inherit Qt's default chrome. The constructors that DO opt in
 * are ``CompactDoubleSpinBox.__init__`` (covers every
 * project-internal QDoubleSpinBox) and the shared ``no_buttons``
 * helper in ``widgets/compact_spinbox.py`` (covers QSpinBox via
 * inspector_sections._no_buttons + drawers/batch/method_buttons).
 *
 * Combo boxes intentionally KEEP their drop-down + arrow rules below;
 * the user requirement was 'QComboBox::drop-down 保留不动'. The four
 * spinbox subcontrols (::up-button / ::down-button / ::up-arrow /
 * ::down-arrow) are collapsed to zero so no gutter rectangle exists at
 * all — paired with widget-side ``setButtonSymbols(NoButtons)`` (set
 * by ``no_buttons`` in widgets/compact_spinbox.py) for double
 * protection against QSS residue on platforms where Qt's native style
 * still draws a default stepper. */
QSpinBox[compact="true"], QDoubleSpinBox[compact="true"] {
    padding-left: 8px;
    padding-right: 8px;
}

QSpinBox[compact="true"]::up-button, QDoubleSpinBox[compact="true"]::up-button,
QSpinBox[compact="true"]::down-button, QDoubleSpinBox[compact="true"]::down-button {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
    subcontrol-position: top right;
}
QSpinBox[compact="true"]::up-arrow, QDoubleSpinBox[compact="true"]::up-arrow,
QSpinBox[compact="true"]::down-arrow, QDoubleSpinBox[compact="true"]::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    padding: 4px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    outline: none;
    selection-background-color: transparent;
    selection-color: #111827;
}
QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
    border: none;
    border-radius: 6px;
    background-color: #ffffff;
    color: #111827;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    border: none;
    border-radius: 6px;
    background-color: #1769e0;
    color: #ffffff;
}

/* Checks */
QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #334155;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #1769e0;
    background-color: #f8fbff;
}
QCheckBox::indicator:checked {
    border-color: #1769e0;
    background-color: #1769e0;
    image: url("{{ICON_CHECKBOX_CHECKED}}");
}
QCheckBox::indicator:disabled {
    border-color: #dfe5ee;
    background-color: #f5f7fb;
}
QCheckBox::indicator:checked:disabled {
    border-color: #dfe5ee;
    background-color: #e2e8f0;
    image: url("{{ICON_CHECKBOX_CHECKED_DISABLED}}");
}

/* Buttons */
QPushButton,
QToolButton {
    min-height: 26px;
    padding: 4px 10px;
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
    color: #111827;
    font-weight: 600;
}
QPushButton:hover,
QToolButton:hover {
    background-color: #f5f7fb;
    border-color: #b7c4d3;
}
QPushButton:pressed,
QToolButton:pressed { background-color: #eef2f7; }
QPushButton:checked,
QToolButton:checked {
    background-color: #e8efff;
    border-color: #1769e0;
    color: #0f3f8f;
}
QPushButton:disabled,
QToolButton:disabled {
    color: #94a3b8;
    background-color: #f5f7fb;
    border-color: #eef2f7;
}
#chartToolbar QToolButton[navActive="true"] {
    background-color: #e8efff;
    border: 1px solid #1769e0;
}

QPushButton[role="primary"],
QToolButton[role="primary"] {
    background-color: #1769e0;
    border-color: #1769e0;
    color: #ffffff;
}
QPushButton[role="primary"]:hover,
QToolButton[role="primary"]:hover {
    background-color: #135abd;
    border-color: #135abd;
}

/* 2026-04-26 R3 紧凑化 fix-4: tool buttons are icon-only chrome
 * around 16x16 icons; outer chrome must hug the icon, not pad to a
 * full 30x30 button. We let setFixedSize(24, 24) on the host widget
 * govern the outer dimensions and only ask QSS for tight internal
 * padding and to override the heavier 26px global min-height. The
 * absence of min-width / min-height here matters: with the global
 * "QPushButton{min-height:26px}" rule above, even setFixedSize is
 * inflated by Qt's CSS sizing math (min-height + padding + border).
 * Setting min-* to 0 here lets setFixedSize win. This selector is
 * scoped via [role="tool"] — toolbar / segment / primary /
 * preset-load buttons keep their own padding rules. */
QPushButton[role="tool"],
QToolButton[role="tool"] {
    min-width: 0;
    min-height: 0;
    padding: 1px 4px;
    border: 1px solid #dfe5ee;
}

/* Toolbar */
Toolbar {
    background-color: #ffffff;
    border-bottom: 1px solid #eef2f7;
}
Toolbar QPushButton {
    min-width: 0;
    min-height: 22px;
    padding: 2px 12px;
}
Toolbar QPushButton[role="panel-toggle"] {
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background-color: transparent;
}
Toolbar QPushButton[role="panel-toggle"]:hover {
    background-color: #f5f7fb;
    border-color: #dfe5ee;
}
Toolbar QPushButton[role="panel-toggle"]:checked {
    background-color: #e8efff;
    border-color: #1769e0;
    border-radius: 3px;
}
Toolbar QPushButton[segment="time"],
Toolbar QPushButton[segment="fft"],
Toolbar QPushButton[segment="fft_time"],
Toolbar QPushButton[segment="order"] {
    min-width: 60px;
    min-height: 20px;
    margin: 0 1px;
    padding: 2px 10px;
    border: none;
    border-radius: 6px;
    background-color: transparent;
    color: #64748b;
}
Toolbar QPushButton[segment]:hover {
    background-color: #eef2f7;
    color: #334155;
}
Toolbar QPushButton[segment]:checked {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #dfe5ee;
}
QWidget#modeSegment {
    padding: 2px;
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: transparent;
}

/* Acquisition Cockpit v3 shell. These selectors are object-name/property
 * scoped so Analyzer's Toolbar and global QPushButton rules keep their
 * existing cascade. */
QFrame#cockpitToolbarBand {
    min-height: 50px;
    max-height: 50px;
    padding: 0;
    border-bottom: 1px solid #eef2f7;
    background-color: #ffffff;
}
QFrame#cockpitToolbarBand QPushButton,
QFrame#cockpitToolbarBand QToolButton {
    min-height: 28px;
    max-height: 36px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}
QFrame#cockpitToolbarBand QPushButton[cockpitAction="connect"] {
    min-height: 36px;
    max-height: 36px;
    padding: 0 20px;
    background-color: #1769e0;
    border-color: #1769e0;
    color: #ffffff;
    font-size: 13px;
}
QFrame#cockpitToolbarBand QPushButton[cockpitAction="record"],
QFrame#cockpitToolbarBand QPushButton[cockpitAction="stop"] {
    min-height: 36px;
    max-height: 36px;
    padding: 0 18px;
    background-color: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
    font-size: 13px;
}
QFrame#cockpitToolbarBand QPushButton[cockpitAction="disabled"] {
    min-height: 36px;
    max-height: 36px;
    padding: 0 18px;
    color: #94a3b8;
    background-color: #f5f7fb;
    border-color: #eef2f7;
}
QWidget#cockpitToolbarSpacer {
    background-color: transparent;
    border: none;
}
QFrame#cockpitToolbarSeparator {
    min-width: 1px;
    max-width: 1px;
    min-height: 22px;
    max-height: 22px;
    background-color: #dfe5ee;
    border: none;
}
QToolButton#cockpitSettingsButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0;
    border-radius: 6px;
}

QLabel#cockpitTransportStatusChip {
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
    border: 1px solid #dfe5ee;
    border-radius: 7px;
    background-color: #f8fafc;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
}
QLabel#cockpitTransportStatusChip[transportState="unconfigured"] {
    background-color: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
}
QLabel#cockpitTransportStatusChip[transportState="configured"] {
    background-color: #ecfdf5;
    border-color: #a7f3d0;
    color: #065f46;
}

QFrame#cockpitSelector,
QFrame#cockpitSelectorA2l,
QFrame#cockpitSelectorDbc,
QFrame#cockpitSelectorOutput,
QPushButton#cockpitSelectorA2l,
QPushButton#cockpitSelectorDbc,
QPushButton#cockpitSelectorOutput {
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    border: 1px solid #dfe5ee;
    border-radius: 6px;
    background-color: #ffffff;
    text-align: left;
}
QFrame#cockpitSelector:hover,
QFrame#cockpitSelectorA2l:hover,
QFrame#cockpitSelectorOutput:hover,
QPushButton#cockpitSelectorA2l:hover,
QPushButton#cockpitSelectorOutput:hover {
    border-color: #b7c4d3;
    background-color: #fbfdff;
}
QFrame#cockpitSelector:disabled,
QFrame#cockpitSelectorDbc:disabled,
QPushButton#cockpitSelectorDbc:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #eef2f7;
}
QFrame#cockpitSelector QLabel#cockpitSelectorKey,
QFrame#cockpitSelectorA2l QLabel#cockpitSelectorKey,
QFrame#cockpitSelectorDbc QLabel#cockpitSelectorKey,
QFrame#cockpitSelectorOutput QLabel#cockpitSelectorKey,
QPushButton#cockpitSelectorA2l QLabel#cockpitSelectorKey,
QPushButton#cockpitSelectorDbc QLabel#cockpitSelectorKey,
QPushButton#cockpitSelectorOutput QLabel#cockpitSelectorKey {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QFrame#cockpitSelector QLabel#cockpitSelectorValue,
QFrame#cockpitSelectorA2l QLabel#cockpitSelectorValue,
QFrame#cockpitSelectorDbc QLabel#cockpitSelectorValue,
QFrame#cockpitSelectorOutput QLabel#cockpitSelectorValue,
QPushButton#cockpitSelectorA2l QLabel#cockpitSelectorValue,
QPushButton#cockpitSelectorDbc QLabel#cockpitSelectorValue,
QPushButton#cockpitSelectorOutput QLabel#cockpitSelectorValue {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#cockpitSelectorA2l QLabel#cockpitSelectorCaret,
QPushButton#cockpitSelectorDbc QLabel#cockpitSelectorCaret,
QPushButton#cockpitSelectorOutput QLabel#cockpitSelectorCaret {
    color: #64748b;
    font-size: 10px;
}

QWidget#cockpitModeSegment {
    min-height: 32px;
    max-height: 32px;
    padding: 2px;
    border: 1px solid #dfe5ee;
    border-radius: 7px;
    background-color: #f8fafc;
}
QWidget#cockpitModeSegment QPushButton[cockpitMode] {
    min-width: 56px;
    min-height: 26px;
    max-height: 26px;
    margin: 0 1px;
    padding: 0 14px;
    border: 1px solid transparent;
    border-radius: 5px;
    background-color: transparent;
    color: #64748b;
}
QWidget#cockpitModeSegment QPushButton[cockpitMode]:hover {
    color: #334155;
    background-color: #eef2f7;
}
QWidget#cockpitModeSegment QPushButton[cockpitMode]:checked {
    color: #0f3f8f;
    background-color: #ffffff;
    border-color: #dfe5ee;
}

QLabel#cockpitRecIndicator {
    min-height: 32px;
    max-height: 32px;
    padding: 0 14px;
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #f8fafc;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}
QLabel#cockpitRecIndicator[recState="off"] {
    background-color: #f8fafc;
    border-color: #dfe5ee;
    color: #64748b;
}
QLabel#cockpitRecIndicator[recState="recording"] {
    background-color: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
}
QLabel#cockpitRecIndicator[recState="warn"] {
    background-color: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
}
QLabel#cockpitRecIndicator[recState="error"] {
    background-color: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
}

QFrame#healthStrip {
    border: none;
    border-bottom: 1px solid #eef2f7;
    background-color: #f5f7fb;
}
QFrame#healthChip {
    min-height: 26px;
    max-height: 26px;
    padding: 0;
    border: 1px solid #dfe5ee;
    border-radius: 13px;
    background-color: #ffffff;
}
QFrame#healthChip[level="green"] {
    border-color: #bbf7d0;
    background-color: #f0fdf4;
}
QFrame#healthChip[level="yellow"] {
    border-color: #fde68a;
    background-color: #fffbeb;
}
QFrame#healthChip[level="red"] {
    border-color: #fecaca;
    background-color: #fef2f2;
}
QFrame#healthChip[level="off"] {
    border-color: #e2e8f0;
    background-color: #f8fafc;
}
QLabel#healthChipLed {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background-color: #94a3b8;
}
QLabel#healthChipLabel {
    color: #334155;
    font-size: 11px;
    font-weight: 800;
}
QLabel#healthChipValue {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QLabel#healthSummary {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#healthDisconnectButton {
    min-height: 24px;
    padding: 2px 8px;
}

QFrame#leftPane {
    border: none;
    border-right: 1px solid #eef2f7;
    background-color: #ffffff;
}
QPushButton#filterChip,
QToolButton#filterChip,
QCheckBox#filterChip {
    min-height: 22px;
    max-height: 22px;
    padding: 0 9px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    background-color: #f8fafc;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#filterChip:hover,
QToolButton#filterChip:hover,
QCheckBox#filterChip:hover {
    background-color: #eef2f7;
    border-color: #b7c4d3;
}
QPushButton#filterChip:checked,
QToolButton#filterChip:checked,
QCheckBox#filterChip:checked {
    color: #0f3f8f;
    background-color: #e8efff;
    border-color: #93b4ef;
}
QPushButton#filterChip:disabled,
QToolButton#filterChip:disabled,
QCheckBox#filterChip:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #eef2f7;
}
QCheckBox#filterChip::indicator {
    width: 0;
    height: 0;
}
QFrame#leftBatchBar {
    min-height: 32px;
    padding: 5px 8px;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    background-color: #eff6ff;
    color: #0f3f8f;
}

QWidget#cockpitDisconnectedCanvas {
    border: 1px dashed #cbd5e1;
    border-radius: 10px;
    background-color: #f8fafc;
}
QWidget#cockpitDisconnectedCanvas QLabel#cockpitDisconnectedTitle {
    color: #111827;
    font-size: 16px;
    font-weight: 800;
}
QWidget#cockpitDisconnectedCanvas QLabel#cockpitDisconnectedCopy {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}
QWidget#cockpitDisconnectedCanvas QPushButton[cockpitAction="connect"] {
    min-height: 32px;
    padding: 4px 14px;
    background-color: #1769e0;
    border-color: #1769e0;
    color: #ffffff;
}

QFrame#liveSignalCard {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
}
QFrame#liveSignalCard[recording="true"] {
    border-left: 1px solid #dc2626;
}
QLabel#liveCardSwatch {
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
    border-radius: 5px;
    background-color: #2563eb;
}
QLabel#liveCardName {
    color: #111827;
    font-size: 12px;
    font-weight: 700;
}
QLabel#liveCardUnit,
QLabel#liveCardRaster,
QLabel#liveCardStats {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QLabel#liveCardValue {
    color: #111827;
    font-size: 16px;
    font-weight: 800;
}

QFrame#rightPanelPage {
    border: none;
    border-left: 1px solid #eef2f7;
    background-color: #ffffff;
}
QFrame#rightMetricSection {
    border: none;
    border-bottom: 1px solid #eef2f7;
    border-radius: 0;
    background-color: #ffffff;
}
QFrame#rightMetricSection QLabel#rightMetricTitle {
    color: #111827;
    font-size: 12px;
    font-weight: 800;
}
QFrame#rightMetricSection QLabel#rightMetricValue,
QFrame#rightMetricSection QLabel#rightMetricDetail {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QFrame#rightVerdictBanner {
    min-height: 34px;
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #f8fafc;
}
QFrame#rightVerdictBanner QLabel {
    color: #475569;
    font-weight: 800;
}
QFrame#rightVerdictBanner[verdict="ready"] {
    background-color: #f0fdf4;
    border-color: #bbf7d0;
}
QFrame#rightVerdictBanner[verdict="ready"] QLabel {
    color: #166534;
}
QFrame#rightVerdictBanner[verdict="warn"] {
    background-color: #fffbeb;
    border-color: #fde68a;
}
QFrame#rightVerdictBanner[verdict="warn"] QLabel {
    color: #92400e;
}
QFrame#rightVerdictBanner[verdict="error"] {
    background-color: #fef2f2;
    border-color: #fecaca;
}
QFrame#rightVerdictBanner[verdict="error"] QLabel {
    color: #991b1b;
}

/* ============ Left navigator ============ */
FileNavigator {
    background-color: #f5f7fb;
    border-right: 1px solid #eef2f7;
}
QWidget#fileArea { background-color: #f5f7fb; }

/* Pane-level heading — 13/700, breathe via padding-right for tracking */
QLabel#paneHeader {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
    padding-right: 6px;
}
/* Numeric count — no fill, colored text only */
QLabel#paneCount {
    min-width: 14px;
    padding: 0 4px;
    border: none;
    background-color: transparent;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}

/* File rows — every card carries its own outline so idle / hover / active
 * differ by border tone + background, not by "frame vs no frame". */
#fileRow {
    border: 1px solid #dfe5ee;
    border-radius: 10px;
    background-color: #ffffff;
}
#fileRow:hover {
    border-color: #b7c4d3;
    background-color: #ffffff;
}
#fileRow[active="true"] {
    /* Selection is shown by the light-blue tint + the 3px #fileAccent stripe
     * on the left. Keep the card outline a NEUTRAL gray here (not blue) so the
     * left edge reads as a single blue stripe, not a border-line + a stripe. */
    border-color: #b7c4d3;
    background-color: #f5f8ff;
}
QFrame#fileAccent {
    background-color: transparent;
    border-radius: 2px;
}
QFrame#fileAccent[active="true"] { background-color: #3b82f6; }

QLabel#fileRowName {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}
QLabel#fileRowMeta {
    color: #64748b;
    font-size: 11px;
}

QLineEdit#channelSearch { min-height: 26px; background-color: #ffffff; }

/* Channel tree — remove zebra stripe + flat header */
QTreeWidget#channelTree {
    border: 1px solid #eef2f7;
    border-radius: 9px;
    background-color: #ffffff;
    alternate-background-color: #ffffff;
    outline: none;
}
QTreeWidget#channelTree::item {
    min-height: 24px;
    padding: 2px 4px;
}
QTreeWidget#channelTree::item:selected {
    background-color: #e8efff;
    color: #111827;
}

QHeaderView::section {
    min-height: 24px;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #eef2f7;
    background-color: transparent;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}

/* ============ Inspector ============ */
Inspector {
    background-color: #f5f7fb;
    border-left: 1px solid #eef2f7;
}
QScrollArea#inspectorScroll {
    border: none;
    background-color: #f5f7fb;
}
QScrollArea#inspectorScroll > QWidget > QWidget {
    background-color: #f5f7fb;
}
Inspector QWidget[inspectorFieldHost="true"] {
    background-color: transparent;
}

/* QGroupBox: no frame. Separation comes from a 12/600 title with a
 * 1px hairline underline (R3 #3-B compactification). The underline
 * replaces the heavier 13/700 typography while keeping enough air
 * between the underline and the first control row. */
Inspector QGroupBox {
    margin-top: 6px;
    padding: 18px 2px 8px;
    border: none;
    border-radius: 0;
    background-color: transparent;
    font-weight: 600;
}
/* 坐标轴设置: drop the 2px right padding so the fluid range editors line up
 * with the card's form fields (色图 / 信号) on the right edge. */
Inspector QGroupBox#axisSettingsGroup {
    padding-right: 0;
}
Inspector QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    right: 0;
    padding: 2px 0 6px 0;
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border-bottom: 1px solid #dfe5ee;
}

/* The same underline rhythm for our custom group-header rows
 * (QFrame#inspectorGroupHeader) so the visual matches across the
 * native QGroupBox flavour and the QFrame-with-button flavour used
 * when a group title needs an inline action button (R3 #9). */
Inspector QFrame#inspectorGroupHeader {
    border: none;
    border-bottom: 1px solid #dfe5ee;
    background-color: transparent;
    padding: 2px 0;
}
Inspector QFrame#inspectorGroupHeader QLabel#inspectorGroupTitle {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}

/* 2026-04-26 R3 紧凑化 fix-2:
 * The sig-card QFrames (fftSignalCard / orderSignalCard / fftTimeSignalCard)
 * are wrappers that group "分析信号" / "信号源" header + fields inside the
 * already-tinted contextual cards. Without this rule, the global
 * "QFrame { background-color: #ffffff }" rule above paints them white and
 * breaks the tinted backdrop bleed-through, producing the screenshot
 * complaint that "信号源 / 分析信号 都变成白底" after R3. We re-transparentize
 * them here AND drop their border, so the tinted contextual is the visual
 * surface and the sig_card is invisible chrome. See lesson
 * pyqt-ui/2026-04-26-inspector-content-max-width-and-tinted-card-bleed.md.
 */
Inspector QFrame#fftSignalCard,
Inspector QFrame#orderSignalCard,
Inspector QFrame#fftTimeSignalCard {
    background-color: #effaf4;
    border: 1px solid #b9dfca;
    border-radius: 8px;
    padding: 0;
}

/* 2026-06-13 分析信号/谱参数 split: each analysis contextual is now a
 * transparent host for two stacked, full-width cards — the green
 * analysis-signal card (sig_card) on top and the tinted parameter card
 * (params_card) below, separated by an 8px #f5f7fb gutter (root spacing).
 * The visible borders/backdrops live on those two cards so they read as two
 * independent panels instead of the old card-inside-a-card; dropping the
 * outer border also lets the analysis-signal card span the pane edge-to-edge
 * (the wider frame the user asked for). */
QWidget#fftContextual,
QWidget#fftTimeContextual,
QWidget#orderContextual {
    border: none;
    background-color: transparent;
}

/* Lower parameter panel (谱参数 / 时频参数 + 坐标轴设置 + 预设 + action).
 * Unified across all three analysis modes to the same #eef4ff tint FFT
 * already used, so the lower panel reads consistently (was: FFT blue,
 * FFT-vs-Time / Order white). */
Inspector QFrame#fftParamsCard,
Inspector QFrame#fftTimeParamsCard,
Inspector QFrame#orderParamsCard {
    background-color: #eef4ff;
    border: 1px solid #dde7f5;
    border-radius: 10px;
}

/* The axis-settings grid is always hosted inside the tinted params_card, so
 * its blank cells stay transparent and let the #eef4ff card show through —
 * no separate white table rows over the panel. */
Inspector QWidget#axisRow,
Inspector QWidget#axisRowLine,
Inspector QWidget#axisAutoCell,
Inspector QWidget#axisRangeHost,
Inspector QWidget#axisRangeSummaryPage,
Inspector QWidget#axisManualRangePage,
Inspector QWidget#axisUnitLine,
Inspector QWidget#axisHeaderRow,
Inspector QWidget#axisHeaderRange {
    background-color: transparent;
}
/* 自动 / 最小 / 最大 column headers above the axis grid — muted + small. */
Inspector QLabel[axisHeader="true"] {
    color: #97a1b2;
    font-size: 11px;
    font-weight: 500;
    background-color: transparent;
}

/* Inspector numeric fields are typed inputs, not stepper controls. Keep
 * QComboBox drop-down arrows above; only spinbox stepper chrome is
 * removed. Selectors are scoped to [compact="true"] (Wave 5, P8-O1) so
 * the global rules above and these Inspector overrides are gated by the
 * same dynamic property — see compact_spinbox.no_buttons / __init__. */
Inspector QSpinBox[compact="true"],
Inspector QDoubleSpinBox[compact="true"] {
    padding-right: 8px;
}
Inspector QSpinBox[compact="true"]::up-button,
Inspector QDoubleSpinBox[compact="true"]::up-button,
Inspector QSpinBox[compact="true"]::down-button,
Inspector QDoubleSpinBox[compact="true"]::down-button {
    width: 0;
    border: none;
    image: none;
}
Inspector QSpinBox[compact="true"]::up-arrow,
Inspector QDoubleSpinBox[compact="true"]::up-arrow,
Inspector QSpinBox[compact="true"]::down-arrow,
Inspector QDoubleSpinBox[compact="true"]::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* Preset slot buttons inside FFT/Order contextual */
QPushButton[role="preset-load"] {
    min-height: 26px;
    padding: 3px 6px;
    font-weight: 600;
}
QPushButton[role="preset-load"][filled="true"] {
    background-color: #ffffff;
    border-color: #b7c4d3;
    color: #0f3f8f;
}
QPushButton[role="preset-load"]:disabled {
    color: #a3aebd;
    background-color: transparent;
    border: 1px dashed #cdd5e0;
}
/* Unit-推荐 highlight: the preset whose signal type matches the active
   channel's unit. Subtle green tint + accent border (reuses the preset
   hover-card success palette #047857 / #e9f9f1) so it reads as a soft
   recommendation, not a saturated selection block. */
QPushButton[role="preset-load"][recommended="true"] {
    color: #047857;
    background-color: #e9f9f1;
    border: 1px solid #34b27f;
    font-weight: 700;
}
QPushButton[role="preset-load"][recommended="true"]:hover {
    background-color: #ddf4ea;
    border-color: #047857;
}
QPushButton[role="preset-save"] {
    min-height: 22px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
    background-color: transparent;
    border: 1px solid transparent;
}
QPushButton[role="preset-save"]:hover {
    color: #334155;
    background-color: #eef2f7;
    border-color: #dfe5ee;
}

/* ============ Toast (floating acknowledgement) ============ */
QFrame#toast {
    border: 1px solid #dfe5ee;
    border-radius: 10px;
    background-color: #ffffff;
}
QFrame#toast[level="success"] {
    border-color: #a7d4b1;
    background-color: #eaf7ee;
}
QFrame#toast[level="warning"] {
    border-color: #f0d090;
    background-color: #fdf6e3;
}
QFrame#toast[level="error"] {
    border-color: #e8a8a8;
    background-color: #fbecec;
}
QLabel#toastText {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#toastIcon {
    min-width: 18px;
    max-width: 18px;
    qproperty-alignment: AlignCenter;
    border-radius: 9px;
    color: #ffffff;
    background-color: #1769e0;
    font-weight: 700;
    font-size: 12px;
}
QLabel#toastIcon[level="success"] { background-color: #16a34a; }
QLabel#toastIcon[level="warning"] { background-color: #d97706; color: #ffffff; }
QLabel#toastIcon[level="error"]   { background-color: #dc2626; }

Inspector QPushButton[role="choice"] {
    min-height: 28px;
    font-weight: 700;
}
Inspector QPushButton[role="choice"]:checked {
    background-color: #1769e0;
    border-color: #1769e0;
    color: #ffffff;
}
Inspector QPushButton[role="primary"] { min-height: 30px; }

/* ============ Chart stack ============ */
ChartStack { background-color: #ffffff; }

QWidget#timeDomainPage {
    background-color: #ffffff;
}

QFrame#timeViewBottomDock {
    background-color: #fbfcff;
    border-top: 1px solid #dbe3ee;
}

QWidget#chartCard {
    border: 1px solid #eef2f7;
    border-radius: 12px;
    background-color: #ffffff;
}

/* Side-by-side compare: the focus cue is a 3px overlay accent strip painted
 * by _ChartCard.set_focus_marker (raised above the canvas), NOT a QSS card
 * border — a card border is hidden behind the full-bleed pyqtgraph canvas. So
 * the focused card keeps the plain #chartCard look here; no frame, no tint,
 * no data-area dimming. */
QWidget#chartCard[focused="true"] {
    border-radius: 12px;
    background-color: #ffffff;
}

/* 2026-06-13 slice info panel — sits in the colorbar column below the
 * colorbar (the slice plot's right edge is pulled in to align its time axis
 * with the heatmap, freeing this column). Holds the X/Y direction switch +
 * the current fixed value / meaning. */
QWidget#slicePanel {
    background-color: #fbfcff;
    border: 1px solid #e1e7f0;
    border-radius: 7px;
}
QWidget#sliceDirToggle {
    background-color: #eef2f8;
    border: 1px solid #c7d2e2;
    border-radius: 8px;
}
QWidget#sliceDirToggle QPushButton[role="slice-seg"] {
    border: none;
    background: transparent;
    color: #7b8699;
    font-size: 9px;
    font-weight: 700;
    min-height: 18px;
    padding: 0 3px;
    border-radius: 7px;
}
QWidget#sliceDirToggle QPushButton[role="slice-seg"]:checked {
    background-color: #2563eb;
    color: #ffffff;
}
QLabel#sliceHint {
    color: #33425c;
    font-size: 9px;
    background: transparent;
}

/* 2026-06-14 折叠下图后的底部细带（drawer 风格，复刻 #sidePanelStrip 淡色）。
 * #plotSplitDivider 仍画自身 1px 拖拽线。 */
QWidget#plotSplitDivider {
    background: transparent;
    border: none;
}
QFrame#plotCollapsedRail {
    background-color: #f3f5f8;
    border: none;
    border-top: 1px solid #e2e6eb;
}
QFrame#plotCollapsedRail:hover {
    background-color: #e7ecf2;
}

/* Chart toolbar — compact spacing & padding (post-i18n). Three selectors
 * to cover Qt style resolution variations: QToolBar (matplotlib subclass),
 * QWidget (object-name match), and the matplotlib subclass name. */
QToolBar#chartToolbar,
QWidget#chartToolbar,
NavigationToolbar2QT#chartToolbar,
NavigationToolbar2QT {
    background-color: #ffffff;
    border-bottom: 1px solid #eef2f7;
    spacing: 1px;
    padding: 1px;
}
QToolBar#chartToolbar QToolButton,
QWidget#chartToolbar QToolButton {
    padding: 2px 4px;
}
QWidget#chartToolbar QToolButton#chartTickDensityButton {
    color: #334155;
    border: 1px solid #b7c8dc;
    border-radius: 7px;
    background-color: #ffffff;
    padding: 0;
}
QWidget#chartToolbar QToolButton#chartTickDensityButton:hover {
    color: #0b7af3;
    border-color: #0b7af3;
    background-color: #e7f1ff;
}
QWidget#chartToolbar QToolButton#chartTickDensityButton:pressed,
QWidget#chartToolbar QToolButton#chartTickDensityButton:focus,
QWidget#chartToolbar QToolButton#chartTickDensityButton:checked {
    color: #334155;
    border-color: #b7c8dc;
    background-color: #ffffff;
}
QWidget#chartToolbar QToolButton:disabled {
    border: 1px solid #e5eaf2;
    border-radius: 6px;
    background-color: #f8fafc;
}

QFrame#cursorPill {
    border: none;
    background: transparent;
    color: #111827;
}
QFrame#cursorPill QLabel#cursorPillPrimary {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QFrame#cursorPill QLabel#cursorPillDetail {
    background: transparent;
}
QPushButton#cursorPillToggle {
    background: rgba(100, 116, 139, 0.15);
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: 3px;
    color: #475569;
    font-size: 10px;
    font-weight: 700;
    padding: 0px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}
QPushButton#cursorPillToggle:hover {
    background: rgba(100, 116, 139, 0.25);
}
QPushButton#cursorPillToggle:pressed {
    background: rgba(100, 116, 139, 0.40);
}

StatsStrip {
    margin: 8px 10px 10px;
    border: 1px solid #eef2f7;
    border-radius: 10px;
    background-color: #ffffff;
}
StatsStrip QLabel { color: #475569; }
StatsStrip QTreeWidget {
    border: 1px solid #eef2f7;
    border-radius: 8px;
    background-color: #ffffff;
    alternate-background-color: #ffffff;
}

/* Drawers / popovers */
QDialog#DrawerSurface,
QDialog#SheetSurface {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #ffffff;
}
/* RebuildTimePopover: the rounded fill rides on an inner QFrame so the
 * translucent shell dialog shows transparent (not boxed) corners. */
QFrame#PopoverSurface {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #ffffff;
}
QFrame#PopoverSurface QLabel { color: #334155; }

QFrame#TickDensitySurface {
    border: 1px solid #b7c8dc;
    border-radius: 8px;
    background-color: #ffffff;
}
QFrame#TickDensitySurface QLabel#tickDensityTitle {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}
QFrame#TickDensitySurface QLabel#tickDensityScope {
    color: #64748b;
    font-size: 11px;
}
QFrame#TickDensitySurface QFrame#tickDensityPresetHost {
    background-color: transparent;
}
QFrame#TickDensitySurface QPushButton[role="tick-density-preset"] {
    min-height: 28px;
    border: 1px solid #dbe5f1;
    border-radius: 6px;
    background-color: #ffffff;
    color: #334155;
    font-size: 12px;
    font-weight: 700;
}
QFrame#TickDensitySurface QPushButton[role="tick-density-preset"]:hover {
    border-color: #b7c8dc;
    background-color: #f8fbff;
}
QFrame#TickDensitySurface QPushButton[role="tick-density-preset"]:checked {
    color: #0b7af3;
    border-color: #0b7af3;
    background-color: #e7f1ff;
}
QFrame#TickDensitySurface QFrame#tickDensityAxisRow {
    background-color: transparent;
}
QFrame#TickDensitySurface QLabel#tickDensityAxisLabel {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
}
QFrame#TickDensitySurface QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background-color: #d9e5f5;
}
QFrame#TickDensitySurface QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border: 2px solid #0b7af3;
    border-radius: 7px;
    background-color: #ffffff;
}
QFrame#TickDensitySurface QSpinBox#tickDensitySpin {
    min-height: 24px;
    border: 1px solid #dbe5f1;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1e293b;
    font-weight: 700;
}
QFrame#TickDensitySurface QPushButton#tickDensityResetButton {
    min-height: 28px;
    border: 1px solid #dbe5f1;
    border-radius: 6px;
    background-color: #ffffff;
    color: #475569;
    font-size: 12px;
}
QFrame#TickDensitySurface QPushButton#tickDensityResetButton:hover {
    border-color: #b7c8dc;
    background-color: #f8fbff;
}

QDialog#ChartOptionsDialog {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #f5f7fb;
}

QDialog#ChartOptionsDialog QLabel#chartOptionsTitle {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
    background-color: transparent;
}

QDialog#ChartOptionsDialog QLabel#chartOptionsSubtitle {
    color: #64748b;
    font-size: 12px;
    background-color: transparent;
}

QDialog#ChartOptionsDialog QTabWidget::pane {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
}

QDialog#ChartOptionsDialog QTabBar::tab {
    min-height: 24px;
    padding: 4px 14px;
    margin-right: 4px;
    border: 1px solid #dfe5ee;
    border-bottom-color: #dfe5ee;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
}

QDialog#ChartOptionsDialog QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0f3f8f;
}

QDialog#ChartOptionsDialog QFrame#chartOptionsGroup {
    border: 1px solid #d8e3f0;
    border-radius: 8px;
    background-color: #ffffff;
}

QDialog#ChartOptionsDialog QLabel#chartOptionsGroupTitle {
    color: #0f2749;
    font-weight: 700;
    background-color: transparent;
}

/* ============ Channel editor (narrow 方案 A drawer body) ============
 * Scoped to #ChannelEditorDialog so the create/danger button accents and
 * the three-band (file bar / scroll body / footer) chrome never leak into
 * the global QPushButton cascade. Tokens mirror the prototype:
 * create  = #0f3f8f text / #cdddf6 border / #f3f8ff fill
 * danger  = #b42318 text / #f1c9c4 border / #fdf4f3 fill
 * primary 确定 reuses the global [role="primary"] blue (#1769e0). */
QDialog#ChannelEditorDialog,
QDialog#DrawerSurface #ChannelEditorDialog {
    background-color: #ffffff;
}
#ChannelEditorDialog QWidget#channelEditorFileBar {
    border-bottom: 1px solid #eef2f7;
    background-color: #fbfcfe;
}
#ChannelEditorDialog QWidget#channelEditorFooter {
    border-top: 1px solid #eef2f7;
    background-color: #fbfcfe;
}
#ChannelEditorDialog QScrollArea#channelEditorScroll {
    border: none;
    background-color: #ffffff;
}
#ChannelEditorDialog QWidget#channelEditorBody {
    background-color: #ffffff;
}
/* Group titles: 12/600 with a 1px hairline underline (matches Inspector). */
#ChannelEditorDialog QGroupBox {
    margin-top: 6px;
    padding: 18px 0 4px;
    border: none;
    background-color: transparent;
    font-weight: 600;
}
#ChannelEditorDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    right: 0;
    padding: 2px 0 6px 0;
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border-bottom: 1px solid #dfe5ee;
}
#ChannelEditorDialog QLabel#channelEditorCount {
    color: #64748b;
    font-size: 12px;
    background-color: transparent;
}
#ChannelEditorDialog QListWidget#channelDeleteList {
    border: 1px solid #eef2f7;
    border-radius: 7px;
    background-color: #ffffff;
    outline: none;
}
#ChannelEditorDialog QListWidget#channelDeleteList::item {
    padding: 3px 6px;
    border-radius: 5px;
}
#ChannelEditorDialog QListWidget#channelDeleteList::item:selected {
    background-color: #e8efff;
    color: #111827;
}
#ChannelEditorDialog QPushButton[role="create"] {
    color: #0f3f8f;
    border: 1px solid #cdddf6;
    background-color: #f3f8ff;
}
#ChannelEditorDialog QPushButton[role="create"]:hover {
    border-color: #93b4ef;
    background-color: #e8efff;
}
#ChannelEditorDialog QPushButton[role="danger"] {
    color: #b42318;
    border: 1px solid #f1c9c4;
    background-color: #fdf4f3;
}
#ChannelEditorDialog QPushButton[role="danger"]:hover {
    border-color: #e3a8a1;
    background-color: #fbe9e7;
}

/* Menus and status */
QMenu {
    padding: 7px;
    border: 1px solid rgba(190, 205, 225, 210);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 238);
}
QMenu::item {
    min-height: 24px;
    padding: 7px 28px 7px 12px;
    border-radius: 8px;
}
QMenu::item:selected {
    background-color: rgba(232, 239, 255, 230);
    color: #111827;
}
QMenu::separator {
    height: 1px;
    margin: 7px 10px;
    background-color: rgba(148, 163, 184, 155);
}

/* ---- TimeDomain right-click context menu (方案 A · Precision Light) ----
 * Native pyqtgraph QMenu reshaped in pg_canvases.redesign_pg_context_menu.
 * objectName 'pgContextMenu' is set on the assembled menu AND each promoted
 * submenu (网格 / 鼠标操作). White surface, hairline light border, comfortable
 * row height, light-blue selected state — kept distinct from data-series
 * colors. Rounded corners ride on WA_TranslucentBackground + this radius
 * (native shell rounding may be imperfect on some platforms — accepted, per
 * the design's native-path decision).
 * Long-form per-side padding (not the shorthand) so a later global QMenu
 * padding tweak cannot silently clobber one side
 * (lesson 2026-04-27-qss-padding-overrides-setcontentsmargins). */
QMenu#pgContextMenu {
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    border: 1px solid rgba(177, 195, 217, 200);
    border-radius: 14px;
    background-color: #ffffff;
}
QMenu#pgContextMenu::item {
    min-height: 30px;
    padding-top: 6px;
    padding-right: 30px;
    padding-bottom: 6px;
    padding-left: 14px;
    border-radius: 9px;
    color: #172033;
}
QMenu#pgContextMenu::item:selected {
    background-color: #e8efff;
    color: #0f3f8f;
}
QMenu#pgContextMenu::item:checked {
    color: #0f3f8f;
    font-weight: 600;
}
QMenu#pgContextMenu::separator {
    height: 1px;
    margin: 6px 12px;
    background-color: rgba(148, 163, 184, 90);
}

QStatusBar {
    background-color: #f5f7fb;
    color: #64748b;
    border-top: 1px solid #eef2f7;
}

/* Version tag beside the status-bar update (cloud-download) icon. */
QStatusBar QLabel#versionTag {
    color: #8893a6;
    font-size: 11px;
    padding-right: 6px;
}

/* ============ Chart toolbar choice segments ============ */
QWidget#chartToolbar QPushButton[role="chart-choice"] {
    min-height: 22px;
    margin: 0 2px;
    padding: 2px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background-color: transparent;
    color: #64748b;
    font-weight: 600;
}
QWidget#chartToolbar QPushButton[role="chart-choice"]:hover {
    background-color: #eef2f7;
    color: #334155;
}
QWidget#chartToolbar QPushButton[role="chart-choice"]:checked {
    background-color: #e8efff;
    border-color: #2563eb;
    color: #2563eb;
}

QWidget#chartToolbar QWidget#chartTimeControlsSpacer {
    background-color: #ffffff;
}

QFrame#chartToolbarSep {
    margin-top: 6px;
    margin-bottom: 6px;
    margin-left: 12px;
    margin-right: 12px;
    background-color: #94a3b8;
    border: none;
}


QLabel#chartHint {
    padding: 0 12px;
    color: #374151;
    font-size: 12px;
    line-height: 14px;
    background-color: transparent;
}

QWidget#viewTabBar {
    background-color: transparent;
    border: none;
}

QWidget#viewTabBar QTabBar#viewTabs {
    background-color: transparent;
}

QWidget#viewTabBar QTabBar#viewTabs::tab {
    min-width: 58px;
    height: 20px;
    margin: 3px 2px 1px 0;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 4px;
    background-color: transparent;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
}

QWidget#viewTabBar QTabBar#viewTabs::tab:hover {
    background-color: #eef4ff;
    border-color: #c7d7f2;
    color: #1f3b68;
}

QWidget#viewTabBar QTabBar#viewTabs::tab:selected {
    background-color: #e8f0ff;
    border-color: #a7bfea;
    border-bottom: 2px solid #2563eb;
    color: #173262;
}

/* Inline rename editor — floats over the tab on double-click. It MUST look
 * like the user is typing directly on the selected tab, NOT a separate white
 * popover box. Mirror the ::tab:selected chrome (tinted blue fill, soft blue
 * border, rounded corners) and match the tab's text metrics so the caret sits
 * where the label text is. The geometry is set in view_tabbar.py to cover the
 * tab's text region; padding here keeps the text horizontally aligned with the
 * label it replaces. */
QWidget#viewTabBar QLineEdit#viewTabRenameEditor {
    background-color: #e8f0ff;
    border: 1px solid #a7bfea;
    border-radius: 4px;
    padding: 0 9px;
    color: #173262;
    font-size: 12px;
    font-weight: 600;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QWidget#viewTabBar QPushButton#viewTabPlus {
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
    margin: 3px 0 1px 2px;
    padding: 0;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background-color: #ffffff;
    color: #1e293b;
    font-weight: 700;
}

QWidget#viewTabBar QPushButton#viewTabPlus:hover {
    background-color: #e8f0ff;
    border-color: #a7bfea;
    color: #173262;
}

/* Disabled = View count hit MAX_VIEWS (6). _update_plus_state already calls
 * setEnabled(False); this rule makes that visually obvious (greyed fill, edge
 * and glyph) so the user sees the cap rather than a still-bright button. */
QWidget#viewTabBar QPushButton#viewTabPlus:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #b8c2d0;
}

/* Cancel-merge button (right side of the View tab bar).
 * The merge relation lives in the button tooltip/accessibility text, not as a
 * persistent status sentence. The button still needs an explicit QSS
 * background/border, otherwise the macOS native push-button bezel can render an
 * empty rounded box and the label disappears. */
QWidget#viewTabBar QLabel#viewSplitChip {
    color: #5a6478;
    padding: 0 6px;
    margin: 3px 0 1px 0;
}

QWidget#viewTabBar QPushButton#viewSplitClear {
    min-height: 22px;
    margin: 3px 2px 1px 0;
    padding: 0 10px;
    border: 1px solid #fb7185;
    border-radius: 5px;
    background-color: #fff1f2;
    color: #be123c;
    font-weight: 600;
}

QWidget#viewTabBar QPushButton#viewSplitClear:hover {
    background-color: #ffe4e6;
    border-color: #f43f5e;
    color: #9f1239;
}

QWidget#viewTabBar QPushButton#viewSplitClear:pressed {
    background-color: #fecdd3;
    border-color: #e11d48;
    color: #881337;
}

/* Bottom hint bar — sits beneath the canvas inside each chart card.
 * Two edge-anchored slots:
 *   #chartHintContext   (left edge, blue)  rotating gesture / context prompts
 *   #chartHintDiscovery (right edge, blue) "this exists" discovery prompts
 * The bar itself has a soft tinted backdrop and a hairline top edge so it
 * reads as a quiet status footer rather than another piece of toolbar. */
QFrame#chartHintBar {
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
}
QFrame#chartHintBar QLabel#chartHintPersistent {
    color: #64748b;
    font-size: 11px;
    padding: 2px 8px;
    background-color: transparent;
}
QFrame#chartHintBar QLabel#chartHintContext {
    color: #2563eb;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    background-color: transparent;
}
QFrame#chartHintBar QLabel#chartHintDiscovery {
    color: #2563eb;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    background-color: transparent;
}

QFrame#timeViewBottomDock QFrame#chartHintBar {
    background-color: #fbfcff;
    border-top: 1px solid #e5ebf3;
}

QFrame#timeViewBottomDock QFrame#chartHintBar QLabel#chartHintPersistent,
QFrame#timeViewBottomDock QFrame#chartHintBar QLabel#chartHintContext,
QFrame#timeViewBottomDock QFrame#chartHintBar QLabel#chartHintDiscovery {
    padding: 1px 6px;
}

QStatusBar QFrame#chartHintBar {
    background-color: transparent;
    border-top: none;
}

QStatusBar QFrame#chartHintBar QLabel#chartHintPersistent,
QStatusBar QFrame#chartHintBar QLabel#chartHintContext,
QStatusBar QFrame#chartHintBar QLabel#chartHintDiscovery {
    padding: 0 6px;
}

/* Batch signal picker chips */
#SignalChip {
    background-color: #eef2f7;
    border: 1px solid #dfe5ee;
    border-radius: 6px;
}
#SignalChipRemove {
    color: #64748b;
    background: transparent;
    border: none;
    padding: 0;
    font-weight: 700;
    min-height: 18px;
}
#SignalChipRemove:hover { color: #ef4444; }

/* Collapsible side panels: faint edge rail + peek overlay */
QFrame#sidePanelStrip {
    background-color: #f3f5f8;
    border: none;
    border-right: 1px solid #e2e6eb;
}
QFrame#sidePanelStrip[side="right"] {
    border-right: none;
    border-left: 1px solid #e2e6eb;
}
QFrame#sidePanelStrip:hover {
    background-color: #e7ecf2;
}
QFrame#peekOverlay {
    background-color: #ffffff;
    border: 1px solid #d3d8df;
    border-radius: 10px;
}
