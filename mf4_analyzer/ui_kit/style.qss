/* ==== MF4 Analyzer — Precision Light visual system (tray/floating-panels) ====
 * Tray / panel depth:
 *   tray  #f2f4f7   backdrop (QMainWindow base, central tray, splitter gaps)
 *   panel/card #ffffff   floating blocks (FileNavigator, ChartStack, Inspector) + cards, inputs, tree, menus
 *   divider    #d3dbe6   splitter line, panel seams, frame seams, card edges (stronger)
 *   hairline   #eef2f7   within-card sub-section separators (soft)
 *   accent #1769e0  ·  accent-wash #e8efff   (interaction only)
 * Text / hierarchy — by size + weight only, no background fills:
 *   pane / card title  13px / 700   #111827
 *   body               12px / 400   #111827
 *   caption / meta     11px / 600   #64748b
 *   numeric badge      11px / 600   #475569  (no fill)
 */

QMainWindow { background-color: #f2f4f7; }

QWidget {
    background-color: #ffffff;
    color: #111827;
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", "SF Pro Text", sans-serif;
    font-size: 12px;
}

QWidget:disabled {
    color: #94a3b8;
}

QFrame,
QGroupBox {
    background-color: #ffffff;
}

/* QLabel inherits QFrame, so strip the default white fill — labels live
 * inline on whatever surface contains them. */
QLabel {
    background-color: transparent;
}

/* Splitter — tray color fills the gap so the panels float apart */
QSplitter::handle { margin: 0; background-color: #f2f4f7; }
QSplitter::handle:horizontal { width: 3px; margin: 0; }
QSplitter::handle:vertical { height: 3px; margin: 0; }
QSplitter::handle:hover { background-color: #cbd5e1; }

/* Scroll areas */
QScrollArea { border: none; background: transparent; }

QScrollBar:vertical { width: 8px; margin: 1px; border: none; background: transparent; }
QScrollBar::handle:vertical { min-height: 28px; border-radius: 4px; background: #d7dee8; }
QScrollBar::handle:vertical:hover { background: #aeb9c8; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { height: 0; background: transparent; }

QScrollBar:horizontal { height: 8px; margin: 1px; border: none; background: transparent; }
QScrollBar::handle:horizontal { min-width: 28px; border-radius: 4px; background: #d7dee8; }
QScrollBar::handle:horizontal:hover { background: #aeb9c8; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { width: 0; background: transparent; }

/* Inputs */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    /* 24px content + 3px vertical padding × 2 + 1px border × 2 = 32px. */
    min-height: {{CONTROL_H_BASE_INPUT_CONTENT}};
    padding: 3px 8px;
    border: 1px solid #dfe5ee;
    border-radius: 7px;
    background-color: #ffffff;
    selection-background-color: #1769e0;
    selection-color: #ffffff;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover { border-color: #b7c4d3; }
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus { border-color: #1769e0; }
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #94a3b8;
    background-color: #f5f7fb;
    border-color: #eef2f7;
}
/* Search is an input-family semantic, not a separate height family.  Named
 * search selectors retain their local colour/chrome only and must resolve to
 * this same base content height. Side icon buttons are child QToolButtons
 * owned by SearchField (not Qt stock clear / addAction widgets). */
QLineEdit[role="search"] {
    min-height: {{CONTROL_H_BASE_INPUT_CONTENT}};
    padding-left: 4px;
    padding-right: 4px;
}
QToolButton#searchFieldIconButton {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
    max-width: 18px;
    max-height: 18px;
}
QToolButton#searchFieldIconButton:hover,
QToolButton#searchFieldIconButton:pressed,
QToolButton#searchFieldIconButton:checked,
QToolButton#searchFieldIconButton:disabled {
    background: transparent;
    border: none;
    color: inherit;
}

/* Combo / spin button regions — provide a faint resting tint so the
 * click target is discoverable without hover, plus explicit arrow
 * glyphs sourced from qtawesome (mdi6.menu-up / mdi6.menu-down) and
 * cached as PNG files under ~/.mf4-analyzer-cache/icons. The
 * placeholders below are substituted at startup by
 * mf4_analyzer.ui.icons.render_qss_template (see app.py loader). See
 * lesson pyqt-ui/2026-04-28-qss-subcontrol-needs-explicit-arrow-glyph.md.
 *
 * Why image:url and not the border-triangle CSS hack: the triangle
 * width is fixed by the border math, so it does not visually scale
 * with the gutter button; HiDPI also amplifies its blocky edge. A
 * vector glyph rasterized to the screen DPR keeps the chevron crisp
 * across scale factors and aligns naturally inside the 22px gutter.
 */
/* The gutter's own corner radii are NOT decoration — they are what keeps
 * the parent's rounded frame visible. ::drop-down is an opaque rectangle
 * laid over the combo's right edge; with square corners its fill paints
 * straight over the two right-hand border arcs, so the frame reads as a
 * pill on the left and a butchered square on the right (the arcs simply
 * vanish, measured 0.44 of the left corners' border ink).
 *
 * Radius rule: subcontrol radius = parent border-radius - border-width.
 * ::drop-down is laid out against the PADDING box, which is already
 * inset by the 1px border, so its arc is one pixel inside the parent's.
 * Here 7px - 1px = 6px. Verified by pixel-diffing the right corners
 * against the (subcontrol-free) left corners: 6px restores the arc with
 * the fill flush against it, while 7px overshoots and leaves a feathered
 * gap between fill and border.
 *
 * This is the ONE gutter rule in the file, and it stays that way because
 * every combo in the app is 7px — the two call sites that used to pick
 * their own radius (#measurementEventSelect at 6px, the import dialog's
 * 34px field at 8px) were folded back in. 7px is the input family's
 * radius, shared with QLineEdit / QSpinBox / QDoubleSpinBox, which combos
 * sit beside constantly in forms; a combo-only value would break that
 * alignment. Introducing a differently-rounded combo means re-deriving
 * this gutter radius for it — tests/ui_kit/test_combo_corner_radius.py
 * fails on both the mismatch and the divergence. */
QComboBox::drop-down {
    width: 22px;
    border: none;
    border-left: 1px solid #eef2f7;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #fafbfd;
}
QComboBox::drop-down:hover { background-color: #eef2f7; }
QComboBox::drop-down:pressed { background-color: #d8e4f5; }
QComboBox::down-arrow {
    image: url("{{ICON_COMBO_DOWN_REST}}");
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:on,
QComboBox::down-arrow:hover {
    image: url("{{ICON_COMBO_DOWN_HOVER}}");
}
QComboBox::down-arrow:disabled {
    image: url("{{ICON_COMBO_DOWN_DISABLED}}");
}

/* Spin boxes that opt-in via ``setProperty('compact', True)`` are
 * rendered as plain editable text fields — the right-gutter stepper
 * buttons were removed (2026-04-29). Users interact via keyboard /
 * scroll wheel only, so we reclaim the previous 24 px right padding
 * back to the symmetric 8 px used on every other side. Long-form
 * ``padding-left`` / ``padding-right`` so the global cascade keeps the
 * top/bottom values from the rule above (see lesson
 * pyqt-ui/2026-04-27-qss-padding-overrides-setcontentsmargins.md).
 *
 * The selectors below are scoped to ``[compact="true"]`` (P8-O1, Wave
 * 5) so any future widget that wants the native stepper — e.g. a
 * third-party dialog or a debug panel — can simply omit the property
 * and inherit Qt's default chrome. The constructors that DO opt in
 * are ``CompactDoubleSpinBox.__init__`` (covers every
 * project-internal QDoubleSpinBox) and the shared ``no_buttons``
 * helper in ``widgets/compact_spinbox.py`` (covers QSpinBox via
 * inspector_sections._no_buttons + drawers/batch/method_buttons).
 *
 * Combo boxes intentionally KEEP their drop-down + arrow rules below;
 * the user requirement was 'QComboBox::drop-down 保留不动'. The four
 * spinbox subcontrols (::up-button / ::down-button / ::up-arrow /
 * ::down-arrow) are collapsed to zero so no gutter rectangle exists at
 * all — paired with widget-side ``setButtonSymbols(NoButtons)`` (set
 * by ``no_buttons`` in widgets/compact_spinbox.py) for double
 * protection against QSS residue on platforms where Qt's native style
 * still draws a default stepper. */
QSpinBox[compact="true"], QDoubleSpinBox[compact="true"] {
    padding-left: 8px;
    padding-right: 8px;
}

QSpinBox[compact="true"]::up-button, QDoubleSpinBox[compact="true"]::up-button,
QSpinBox[compact="true"]::down-button, QDoubleSpinBox[compact="true"]::down-button {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
    subcontrol-position: top right;
}
QSpinBox[compact="true"]::up-arrow, QDoubleSpinBox[compact="true"]::up-arrow,
QSpinBox[compact="true"]::down-arrow, QDoubleSpinBox[compact="true"]::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    padding: 4px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background-color: transparent;
    outline: none;
    selection-background-color: transparent;
    selection-color: #111827;
}
QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
    border: none;
    border-radius: 6px;
    background-color: #ffffff;
    color: #111827;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    border: none;
    border-radius: 6px;
    background-color: #1769e0;
    color: #ffffff;
}

/* Saved-channel configuration picker: its delegate owns row contents, while
 * this surface rule supplies the quiet rounded shell around those aligned rows. */
QComboBox[popupStyle="channel-config"] QAbstractItemView::item {
    min-height: 0;
    padding: 0;
    background: transparent;
}

QDialog#channelConfigManager {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
}
QFrame#channelConfigManagerHeader {
    border: none;
    border-bottom: 1px solid #eef2f7;
    background-color: #ffffff;
}
QLabel#channelConfigManagerTitle {
    color: #111827;
    font-size: 17px;
    font-weight: 700;
}
QLabel#channelConfigManagerSubtitle {
    color: #64748b;
    font-size: 12px;
}
QFrame#channelConfigManagerToolbar,
QFrame#channelConfigManagerFooter {
    border: none;
    background-color: #fbfdff;
}
QFrame#channelConfigManagerToolbar { border-bottom: 1px solid #eef2f7; }
QFrame#channelConfigManagerFooter { border-top: 1px solid #eef2f7; }
QLineEdit#channelConfigManagerSearch { min-height: {{CONTROL_H_BASE_INPUT_CONTENT}}; }
QPushButton#channelConfigManagerCreate { min-height: {{CONTROL_H_BASE_BUTTON_CONTENT}}; }
QWidget#channelConfigManagerContent { background-color: #ffffff; }
QTableWidget#channelConfigManagerTable {
    border: none;
    border-right: 1px solid #eef2f7;
    background-color: #ffffff;
    alternate-background-color: #ffffff;
    color: #1f2937;
    outline: none;
}
QTableWidget#channelConfigManagerTable::item {
    padding: 0 8px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    background-color: #ffffff;
}
QTableWidget#channelConfigManagerTable::item:hover { background-color: #f8fbff; }
QTableWidget#channelConfigManagerTable QHeaderView::section {
    min-height: 28px;
    padding: 0 8px;
    border: none;
    border-bottom: 1px solid #eef2f7;
    background-color: #fbfdff;
    color: #718096;
    font-size: 11px;
    font-weight: 600;
}
QFrame#channelConfigManagerDetail {
    border: none;
    background-color: #fcfdff;
}
QLabel#channelConfigManagerEyebrow,
QLabel#channelConfigManagerFieldLabel {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QLabel#channelConfigManagerDetailTitle {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}
QLabel#channelConfigManagerDetailDescription {
    color: #64748b;
    font-size: 12px;
}
QLabel#channelConfigManagerNote {
    padding: 9px;
    border-radius: 7px;
    background-color: #f1f5f9;
    color: #64748b;
    font-size: 11px;
}
QLabel#channelConfigManagerCount { color: #334155; font-weight: 600; }
QLabel#channelConfigManagerHint { color: #94a3b8; font-size: 11px; }
QPushButton#channelConfigManagerDelete {
    color: #b42318;
    border-color: #f1c9c4;
    background-color: #fdf4f3;
}
QPushButton#channelConfigManagerDelete:hover {
    color: #8f1d15;
    border-color: #e3a8a1;
    background-color: #fbe9e7;
}

/* Checks */
QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #334155;
    background-color: transparent;
}

QLabel#BatchAnalysisChoiceLabel {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QWidget#BatchParamCell { background-color: transparent; }
QLabel#BatchParamLabel {
    color: #556378;
    font-size: 10px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#BatchParamColumnTitle {
    color: #334155;
    font-size: 11px;
    font-weight: 700;
    background-color: transparent;
}
QPushButton#BatchAnalysisPresetCard {
    /* 54px content + 5px top/bottom padding + 1px borders = 66px surface. */
    min-height: 54px;
    max-height: 54px;
    padding: 5px 7px;
    /* Same quiet button chrome as the single-analysis preset strip.  Batch
     * keeps its two-line content and 66px hit target, not a second visual
     * button family. */
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{CONTROL_SURFACE_TOP}}, stop: 1 {{CONTROL_SURFACE_BOTTOM}}
    );
    color: {{CONTROL_TEXT}};
    font-size: 10px;
    font-weight: 600;
}
/* Compact cards retain a 40px outer surface under the shared card chrome. */
QPushButton#BatchAnalysisPresetCard[compact="true"] {
    min-height: 28px;
    max-height: 28px;
}
QPushButton#BatchAnalysisPresetCard:hover {
    border-color: #b7c4d3;
    background-color: {{CONTROL_ACCENT_WASH}};
}
QPushButton#BatchAnalysisPresetCard:checked {
    border-color: #0b73e7;
    background-color: #e8f1ff;
    color: #0b73e7;
}
QPushButton#BatchAnalysisPresetCard:disabled {
    color: #a0aec0;
    background-color: #f7f9fc;
}
QLabel#BatchPresetSyncBadge {
    padding: 3px 7px;
    border-radius: 9px;
    color: #087f5b;
    background-color: #e9fbf3;
    font-size: 10px;
    font-weight: 700;
}
QLabel#BatchPresetSourceNote,
QLabel#BatchPresetState {
    color: #64748b;
    font-size: 10px;
}
QLabel#BatchPresetState[modified="true"] { color: #b45309; }
QPushButton#BatchGroupingCard {
    min-height: 132px;
    padding: 0;
    border: 1px solid #d7e2f0;
    border-radius: 9px;
    background-color: #ffffff;
    color: #334155;
    font-size: 10px;
    font-weight: 700;
    text-align: left;
}
QPushButton#BatchGroupingCard:hover {
    border-color: #9fc1ee;
    background-color: #f8fbff;
}
QPushButton#BatchGroupingCard:checked {
    border-color: {{CONTROL_SELECT_LINE}};
    background-color: {{CONTROL_TRACK}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
QFrame#BatchInlineFileManager {
    border: 1px solid #d7e2f0;
    border-radius: 9px;
    background-color: #ffffff;
}
QLabel#BatchSectionTitle { color: #26344a; font-size: 12px; font-weight: 700; }
QLabel#BatchSectionNote { color: #94a3b8; font-size: 10px; }
QLabel#BatchFileFacts { color: #64748b; font-size: 9px; }
QLabel#BatchFileReadyPill {
    padding: 3px 7px;
    border-radius: 9px;
    color: #5e6e83;
    background-color: #eef2f7;
    font-size: 9px;
    font-weight: 700;
}
QLabel#BatchFileReadyPill[status="ready"] {
    color: #087453;
    background-color: #e9f8f2;
}
QLabel#BatchFileReadyPill[status="error"] {
    color: #b42335;
    background-color: #fff0f2;
}
/* The outer frame exclusively paints this rounded surface.  Its touching
 * children remain transparent so they cannot square off the parent's arc. */
QWidget#BatchInlineFileManagerBody,
QListWidget#BatchFileList,
QListWidget#BatchFileList::viewport,
QWidget#BatchStructuredFileRow,
QWidget#BatchFileRowCopy,
QLabel#BatchFileEmptyState {
    background-color: transparent;
}
QPushButton#BatchFileAddLoaded,
QPushButton#BatchFileAddDisk {
    min-height: 24px;
    padding: 3px 8px;
}
QPushButton#BatchFileAddLoaded {
    color: #0f56bd;
    border-color: #bdd2f0;
    background-color: #f4f8fe;
}
QPushButton#BatchFileRowRemove {
    border: none;
    border-radius: 6px;
    color: #64748b;
    background-color: #f2f5f9;
    padding: 0;
}
QPushButton#BatchFileRowRemove { background-color: transparent; }
QPushButton#BatchFileRowRemove:hover {
    color: #dc3f52;
    background-color: #fff0f2;
}
QListWidget#BatchFileList {
    border: none;
    border-top: 1px solid #edf1f6;
    border-radius: 0;
    outline: none;
    padding: 4px;
}
QLabel#BatchFileEmptyState {
    border-top: 1px solid #edf1f6;
    color: #64748b;
    font-size: 10px;
}
QWidget#BatchStructuredFileRow {
    border-bottom: 1px solid #edf1f6;
}
QLabel#BatchFileStateDot { border-radius: 4px; background-color: #f0a100; }
QLabel#BatchFileStateDot[ready="true"] { background-color: #0ea875; }
QLabel#BatchFileStateDot[failed="true"] { background-color: #dc3f52; }
QLabel#BatchFileRowName { color: #26344a; font-size: 10px; font-weight: 700; }
QLabel#BatchFileRowPath { color: #64748b; font-size: 8px; }
QLabel#BatchFileRowState { color: #9a6800; font-size: 9px; }
QLabel#BatchFileRowState[ready="true"] { color: #087453; }
QLabel#BatchFileRowState[failed="true"] { color: #b42335; }
QWidget#BatchFilterSummary {
    border: 1px solid #dbe4ef;
    border-radius: 8px;
    background-color: #fafbfd;
}
QLabel#BatchFilterSummaryTitle {
    color: #26344a;
    font-size: 11px;
    font-weight: 700;
}
QLabel#BatchFilterSummaryNote { color: #64748b; font-size: 10px; }
/* Option C soft separator: pale within-card hairline + quiet caption.
 * Used above optional Batch add-ons (slice / chart stats / preprocessing…). */
QWidget#BatchOptionalEyebrow {
    background-color: transparent;
}
QWidget#BatchOptionalEyebrowRule {
    background-color: #eef2f7;
    border: none;
}
QLabel#BatchOptionalEyebrowLabel {
    color: #94a3b8;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.4px;
    background-color: transparent;
}
/* 图内统计 · 方案 A（对齐 HTML 原型）：淡蓝 chip + 圆点，不是实心勾选框 */
QLabel#BatchChartStatisticsRowLabel {
    color: #556378;
    font-size: 10px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#BatchChartStatisticsSpinLab {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    background-color: transparent;
}
QLabel#BatchChartStatisticsDash,
QLabel#BatchChartStatisticsUnit {
    color: #94a3b8;
    font-size: 10px;
    background-color: transparent;
}
QLabel#BatchChartStatisticsNote {
    color: #64748b;
    font-size: 10px;
    background-color: transparent;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric {
    min-height: 26px;
    max-height: 26px;
    spacing: 5px;
    padding: 0 9px 0 7px;
    border: 1px solid #dbe4ef;
    border-radius: 999px;
    background-color: #ffffff;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric:hover {
    border-color: #c8d4e3;
    color: #334155;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric:checked {
    border-color: #cfe0f8;
    background-color: #eaf2ff;
    color: #0f56bd;
    font-weight: 700;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #e2e8f0;
}
/* 压过全局 16px 蓝底白勾，做成 HTML .mchip .dot */
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric::indicator {
    width: 8px;
    height: 8px;
    border: none;
    border-radius: 4px;
    background-color: #94a3b8;
    image: none;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric::indicator:hover {
    background-color: #64748b;
    image: none;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric::indicator:checked {
    background-color: #5b8fd4;
    image: none;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric::indicator:disabled {
    background-color: #cbd5e1;
    image: none;
}
QWidget#BatchChartStatistics QCheckBox#BatchChartStatisticsMetric::indicator:checked:disabled {
    background-color: #cbd5e1;
    image: none;
}
QLabel#BatchChartStatisticsRangeSummary {
    color: #64748b;
    font-size: 10px;
}
QWidget#BatchChartStatisticsContextField {
    min-height: 28px;
    border: 1px solid #dbe4ef;
    border-radius: 7px;
    background-color: #ffffff;
}
QLabel#BatchChartStatisticsContextPrefix {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    background-color: transparent;
}
QLabel#BatchChartStatisticsContext {
    color: #26344a;
    font-size: 10px;
    background-color: transparent;
}
QLabel#BatchChartStatisticsContextUnit {
    color: #94a3b8;
    font-size: 10px;
    background-color: transparent;
}
QWidget#BatchCompactFooter {
    border-top: 1px solid #e2e8f0;
    background-color: #fbfcfe;
}
QWidget#BatchCompactFooter QPushButton,
QDialog#BatchPreviewDialog QPushButton {
    min-height: {{CONTROL_H_CTA_BUTTON_CONTENT}};
    min-width: 76px;
    padding: 4px 14px;
    font-weight: 700;
}
/* 代表最终图预览对话框里的警告条——沿用项目既有的低饱和琥珀警示色
 * （见 cockpitRecIndicator[recState="warn"] / rightVerdictBanner[verdict="warn"]）。
 * 只在 result.warnings 非空时显示，空时整块隐藏、不占位。 */
QLabel#batchPreviewWarnings {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 6px;
    color: #92400e;
    padding: 6px 10px;
    font-size: 12px;
}
QWidget#BatchCompactToolbar {
    border-bottom: 1px solid #e8edf4;
    background-color: #fbfcfe;
}
/* The preset buttons are secondary chrome, so they run shorter than the
 * footer's action buttons and let the toolbar row sit at 36px. */
QWidget#BatchCompactToolbar QPushButton {
    min-height: {{CONTROL_H_COMPACT_BUTTON_CONTENT}};
    padding: 2px 10px;
}
QLabel#BatchToolbarTitle { color: #4b596c; font-size: 12px; font-weight: 700; }
QLabel#BatchToolbarMeta { color: #94a3b8; font-size: 11px; }
QLabel#BatchFooterStateDot {
    border-radius: 4px;
    background-color: #0ea875;
}
QLabel#BatchFooterStateDot[state="blocked"] { background-color: #ef8c00; }
QLabel#BatchFooterStateDot[state="running"] { background-color: #1769e0; }
QLabel#BatchFooterStateDot[state="cancelling"] { background-color: #dc3f52; }
QLabel#BatchFooterStateDot[state="partial"] { background-color: #ef8c00; }
QLabel#BatchFooterStateDot[state="cancelled"] { background-color: #64748b; }
QLabel#BatchFooterStatus { color: #334155; font-size: 11px; font-weight: 700; }
QLabel#BatchFooterTaskSummary { color: #64748b; font-size: 11px; }
QProgressBar#BatchFooterProgress {
    min-height: 7px;
    max-height: 7px;
    border: none;
    border-radius: 3px;
    background-color: #e7edf5;
}
QProgressBar#BatchFooterProgress::chunk {
    border-radius: 3px;
    background-color: #1769e0;
}
QRadioButton#BatchAnalysisPresetOption {
    min-height: 26px;
    spacing: 5px;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QRadioButton#BatchAnalysisPresetOption:checked {
    color: #0f3f8f;
    font-weight: 700;
}
QRadioButton#BatchAnalysisPresetOption:disabled {
    color: #a0aec0;
}
QRadioButton#BatchAnalysisPresetOption::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #94a3b8;
    border-radius: 7px;
    background-color: #ffffff;
}
QRadioButton#BatchAnalysisPresetOption::indicator:hover {
    border-color: #1769e0;
}
QRadioButton#BatchAnalysisPresetOption::indicator:checked {
    border: 1px solid #1769e0;
    border-radius: 7px;
    background-color: #1769e0;
}
QRadioButton#BatchAnalysisPresetOption::indicator:disabled {
    border-color: #cbd5e1;
    background-color: #f5f7fb;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #1769e0;
    background-color: #f8fbff;
}
QCheckBox::indicator:checked {
    border-color: #1769e0;
    background-color: #1769e0;
    image: url("{{ICON_CHECKBOX_CHECKED}}");
}
QCheckBox::indicator:disabled {
    border-color: #dfe5ee;
    background-color: #f5f7fb;
}
QCheckBox::indicator:checked:disabled {
    border-color: #dfe5ee;
    background-color: #e2e8f0;
    image: url("{{ICON_CHECKBOX_CHECKED_DISABLED}}");
}

/* Buttons */
QPushButton,
QToolButton {
    /* base 32px = 22px content + 4px vertical padding × 2 + 1px border × 2 */
    min-height: {{CONTROL_H_BASE_BUTTON_CONTENT}};
    padding: 4px 10px;
    border: 1px solid {{CONTROL_LINE}};
    border-radius: 8px;
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{CONTROL_SURFACE_TOP}}, stop: 1 {{CONTROL_SURFACE_BOTTOM}}
    );
    color: {{CONTROL_TEXT}};
    font-weight: 600;
}
QPushButton:hover,
QToolButton:hover {
    background-color: {{CONTROL_ACCENT_WASH}};
    border-color: {{CONTROL_LINE_HOVER}};
}
QPushButton:pressed,
QToolButton:pressed { background-color: {{CONTROL_TRACK}}; }
QPushButton:checked,
QToolButton:checked {
    background-color: {{CONTROL_ACCENT_WASH}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
QPushButton:disabled,
QToolButton:disabled {
    color: {{CONTROL_TEXT_MUTED}};
    background-color: {{CONTROL_DISABLED_BG}};
    border-color: {{CONTROL_DISABLED_LINE}};
}
#chartToolbar QToolButton[navActive="true"] {
    background-color: #e8efff;
    border-color: #1769e0;
}

/* File-scope follow link: active = persistent wash; idle = icon only.
 * Generic role="icon" hover/pressed washes must not steal either state —
 * hover used to erase the active tint, and a click on the idle (all-off)
 * icon flashed a misleading "on" background. */
QToolButton#autoAttachFiles[active="true"],
QToolButton#autoAttachFiles[active="true"]:hover,
QToolButton#autoAttachFiles[active="true"]:pressed,
QToolButton#autoAttachFiles[active="true"]:focus {
    background-color: {{CONTROL_ACCENT_WASH}};
    border: 1px solid {{CONTROL_SELECT_LINE}};
    border-radius: 6px;
}
QToolButton#autoAttachFiles[active="false"],
QToolButton#autoAttachFiles[active="false"]:hover,
QToolButton#autoAttachFiles[active="false"]:pressed,
QToolButton#autoAttachFiles[active="false"]:focus {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

QPushButton[role="primary"],
QToolButton[role="primary"] {
    min-height: {{CONTROL_H_CTA_BUTTON_CONTENT}};
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{CONTROL_ACCENT_HI}}, stop: 1 {{CONTROL_ACCENT}}
    );
    border-color: {{CONTROL_ACCENT_BORDER}};
    color: {{CONTROL_SURFACE_TOP}};
}
QPushButton[role="primary"]:hover,
QToolButton[role="primary"]:hover {
    background-color: {{CONTROL_ACCENT_HI}};
    border-color: {{CONTROL_ACCENT}};
}
QPushButton[role="primary"]:pressed,
QToolButton[role="primary"]:pressed {
    background-color: {{CONTROL_ACCENT_DARK}};
    border-color: {{CONTROL_ACCENT_DARK}};
}
QPushButton[role="primary"]:checked,
QToolButton[role="primary"]:checked {
    background-color: {{CONTROL_ACCENT}};
    border-color: {{CONTROL_ACCENT_BORDER}};
    color: {{CONTROL_SURFACE_TOP}};
}
QPushButton[role="primary"]:disabled,
QToolButton[role="primary"]:disabled {
    color: {{CONTROL_TEXT_MUTED}};
    background-color: {{CONTROL_DISABLED_BG}};
    border-color: {{CONTROL_DISABLED_LINE}};
}

QPushButton[role="secondary"],
QToolButton[role="secondary"],
QPushButton[role="accent"],
QToolButton[role="accent"],
QPushButton[role="create"],
QToolButton[role="create"] {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{CONTROL_SURFACE_TOP}}, stop: 1 {{CONTROL_ACCENT_WASH}}
    );
    border-color: {{CONTROL_ACCENT_LINE_SOFT}};
    color: {{CONTROL_ACCENT}};
}
QPushButton[role="secondary"]:hover,
QToolButton[role="secondary"]:hover,
QPushButton[role="accent"]:hover,
QToolButton[role="accent"]:hover,
QPushButton[role="create"]:hover,
QToolButton[role="create"]:hover {
    background-color: {{CONTROL_ACCENT_WASH}};
    border-color: {{CONTROL_ACCENT}};
    color: {{CONTROL_ACCENT_DARK}};
}
QPushButton[role="secondary"]:pressed,
QToolButton[role="secondary"]:pressed,
QPushButton[role="accent"]:pressed,
QToolButton[role="accent"]:pressed,
QPushButton[role="create"]:pressed,
QToolButton[role="create"]:pressed {
    background-color: {{CONTROL_TRACK}};
    border-color: {{CONTROL_ACCENT_LINE_SOFT}};
}
QPushButton[role="secondary"]:checked,
QToolButton[role="secondary"]:checked,
QPushButton[role="accent"]:checked,
QToolButton[role="accent"]:checked,
QPushButton[role="create"]:checked,
QToolButton[role="create"]:checked {
    background-color: {{CONTROL_ACCENT_WASH}};
    border-color: {{CONTROL_ACCENT}};
    color: {{CONTROL_ACCENT_DARK}};
}
QPushButton[role="secondary"]:disabled,
QToolButton[role="secondary"]:disabled,
QPushButton[role="accent"]:disabled,
QToolButton[role="accent"]:disabled,
QPushButton[role="create"]:disabled,
QToolButton[role="create"]:disabled {
    color: {{CONTROL_TEXT_MUTED}};
    background-color: {{CONTROL_DISABLED_BG}};
    border-color: {{CONTROL_DISABLED_LINE}};
}

QPushButton[role="quiet"],
QToolButton[role="quiet"],
QPushButton[role="icon"],
QToolButton[role="icon"] {
    border-color: transparent;
    background-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
}
QPushButton[role="quiet"]:hover,
QToolButton[role="quiet"]:hover,
QPushButton[role="icon"]:hover,
QToolButton[role="icon"]:hover {
    background-color: {{CONTROL_ACCENT_WASH}};
    border-color: {{CONTROL_LINE_HOVER}};
    color: {{CONTROL_TEXT}};
}
QPushButton[role="quiet"]:pressed,
QToolButton[role="quiet"]:pressed,
QPushButton[role="icon"]:pressed,
QToolButton[role="icon"]:pressed {
    background-color: {{CONTROL_TRACK}};
    border-color: {{CONTROL_TRACK_LINE}};
}
QPushButton[role="quiet"]:checked,
QToolButton[role="quiet"]:checked,
QPushButton[role="icon"]:checked,
QToolButton[role="icon"]:checked {
    background-color: {{CONTROL_ACCENT_WASH}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
QPushButton[role="quiet"]:disabled,
QToolButton[role="quiet"]:disabled,
QPushButton[role="icon"]:disabled,
QToolButton[role="icon"]:disabled {
    background-color: transparent;
    border-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
}

/* Icon roles deliberately have no fixed outer size: a 24px/28px caller
 * geometry stays authoritative. These values are calibrated against the real
 * 16px-icon QToolButton style hint: its fixed 24px host stays 24×24 and no
 * longer clips because the hint asks for 29×27. */
QPushButton[role="icon"],
QToolButton[role="icon"] {
    min-width: {{CONTROL_H_ICON_HINT_CONTENT}};
    min-height: {{CONTROL_H_ICON_HINT_CONTENT}};
    padding: 0;
}

QPushButton[role="danger"],
QToolButton[role="danger"],
QPushButton[role="destructive"],
QToolButton[role="destructive"] {
    color: {{CONTROL_DANGER}};
    border-color: {{CONTROL_DANGER}};
    background-color: {{CONTROL_SURFACE_TOP}};
}
QPushButton[role="danger"]:hover,
QToolButton[role="danger"]:hover,
QPushButton[role="destructive"]:hover,
QToolButton[role="destructive"]:hover {
    background-color: {{CONTROL_DANGER_WASH}};
    border-color: {{CONTROL_DANGER}};
}
QPushButton[role="danger"]:pressed,
QToolButton[role="danger"]:pressed,
QPushButton[role="destructive"]:pressed,
QToolButton[role="destructive"]:pressed {
    background-color: {{CONTROL_DANGER_WASH}};
    border-color: {{CONTROL_DANGER}};
}
QPushButton[role="danger"]:checked,
QToolButton[role="danger"]:checked,
QPushButton[role="destructive"]:checked,
QToolButton[role="destructive"]:checked {
    background-color: {{CONTROL_DANGER_WASH}};
    border-color: {{CONTROL_DANGER}};
    color: {{CONTROL_DANGER}};
}
QPushButton[role="danger"]:disabled,
QToolButton[role="danger"]:disabled,
QPushButton[role="destructive"]:disabled,
QToolButton[role="destructive"]:disabled {
    color: {{CONTROL_TEXT_MUTED}};
    background-color: {{CONTROL_DISABLED_BG}};
    border-color: {{CONTROL_DISABLED_LINE}};
}

QPushButton[role="choice"],
QToolButton[role="choice"] {
    background-color: transparent;
    border-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
}
QPushButton[role="choice"]:hover,
QToolButton[role="choice"]:hover {
    background-color: {{CONTROL_TRACK}};
    border-color: {{CONTROL_TRACK_LINE}};
    color: {{CONTROL_TEXT}};
}
QPushButton[role="choice"]:pressed,
QToolButton[role="choice"]:pressed {
    background-color: {{CONTROL_TRACK}};
    border-color: {{CONTROL_SELECT_LINE}};
}
QPushButton[role="choice"]:checked,
QToolButton[role="choice"]:checked {
    background-color: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
QPushButton[role="choice"]:disabled,
QToolButton[role="choice"]:disabled {
    color: {{CONTROL_TEXT_MUTED}};
    background-color: {{CONTROL_DISABLED_BG}};
    border-color: {{CONTROL_DISABLED_LINE}};
}

/* An explicit helper size is an opt-in track override.  Role defaults above
 * still keep an unannotated primary on cta and ordinary actions on base. */
QPushButton[controlSize="compact"],
QToolButton[controlSize="compact"] {
    min-height: {{CONTROL_H_COMPACT_STANDARD_BUTTON_CONTENT}};
}
QPushButton[controlSize="base"],
QToolButton[controlSize="base"] {
    min-height: {{CONTROL_H_BASE_BUTTON_CONTENT}};
}
QPushButton[controlSize="cta"],
QToolButton[controlSize="cta"] {
    min-height: {{CONTROL_H_CTA_BUTTON_CONTENT}};
}
/* Icon-only QToolButtons have additional Qt icon chrome in their size hint.
 * Keep the calibrated 19px floor so fixed 24px and 28px callers remain
 * authoritative without clipping their 16px glyphs. */
QPushButton[role="icon"][controlSize="compact"],
QToolButton[role="icon"][controlSize="compact"] {
    min-width: {{CONTROL_H_ICON_HINT_CONTENT}};
    min-height: {{CONTROL_H_ICON_HINT_CONTENT}};
    padding: 0;
}

QMessageBox QPushButton {
    min-width: 52px;
    min-height: 24px;
    padding: 2px 10px;
}
QMessageBox QPushButton[messageBoxRole="neutral"] {
    background-color: #ffffff;
    border-color: #dfe5ee;
    color: #111827;
}
QMessageBox QPushButton[messageBoxRole="neutral"]:hover {
    background-color: #f5f7fb;
    border-color: #b7c4d3;
}
QMessageBox QPushButton[messageBoxRole="primary"] {
    background-color: {{CONTROL_ACCENT}};
    border-color: {{CONTROL_ACCENT_BORDER}};
    color: {{CONTROL_SURFACE_TOP}};
}
QMessageBox QPushButton[messageBoxRole="primary"]:hover {
    background-color: {{CONTROL_ACCENT_DARK}};
    border-color: {{CONTROL_ACCENT_DARK}};
}
QMessageBox QPushButton[messageBoxRole="warning"] {
    background-color: #d97706;
    border-color: #d97706;
    color: #ffffff;
}
QMessageBox QPushButton[messageBoxRole="warning"]:hover {
    background-color: #b45309;
    border-color: #b45309;
}
QMessageBox QPushButton[messageBoxRole="danger"] {
    background-color: {{CONTROL_DANGER}};
    border-color: {{CONTROL_DANGER}};
    color: {{CONTROL_SURFACE_TOP}};
}
QMessageBox QPushButton[messageBoxRole="danger"]:hover {
    background-color: {{CONTROL_DANGER_WASH}};
    border-color: {{CONTROL_DANGER}};
    color: {{CONTROL_DANGER}};
}

/* 2026-04-26 R3 紧凑化 fix-4: tool buttons are icon-only chrome
 * around 16x16 icons; outer chrome must hug the icon, not pad to a
 * full 30x30 button. We let setFixedSize(24, 24) on the host widget
 * govern the outer dimensions and only ask QSS for tight internal
 * padding and to override the heavier 26px global min-height. The
 * absence of min-width / min-height here matters: with the global
 * "QPushButton{min-height:26px}" rule above, even setFixedSize is
 * inflated by Qt's CSS sizing math (min-height + padding + border).
 * Setting min-* to 0 here lets setFixedSize win. This selector is
 * scoped via [role="tool"] — toolbar / segment / primary /
 * preset-load buttons keep their own padding rules. */
QPushButton[role="tool"],
QToolButton[role="tool"] {
    min-width: 0;
    min-height: 0;
    padding: 1px 4px;
    border-color: #dfe5ee;
}

/* Saved-channel config controls live in the navigator rail.  They are action
 * peers, not compact toolbar glyphs: keep both on the base track. */
QPushButton#channelConfigSave,
QPushButton#channelConfigApply {
    /* Qt stylesheet widths exclude padding and borders.  46 + 16 + 2 gives
     * an actual 64px action button: readable, but leaves the rail width to
     * the selector. */
    min-width: 46px;
    max-width: 46px;
    /* 22px content + 4px vertical padding × 2 + 1px border × 2 = 32px,
     * exactly matching #channelConfigCombo's fixed outer height. */
    min-height: {{CONTROL_H_BASE_BUTTON_CONTENT}};
    padding: 4px 8px;
}

/* Toolbar */
Toolbar#surfaceTopBar,
QWidget#surfaceTopBar {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 8px;
}
/* Left action group + logo group: transparent so they sit on the tray band
 * (no white box; lets the logo embed into the tray). */
Toolbar QWidget#toolbarLeftGroup,
Toolbar QWidget#toolbarRightGroup {
    background-color: transparent;
    border: none;
}
Toolbar QPushButton {
    min-width: 0;
    min-height: {{CONTROL_H_COMPACT_BUTTON_CONTENT}};
    padding: 2px 12px;
}
/* “打开” keeps the primary fill but shares this compact toolbar row's height. */
Toolbar QPushButton[role="primary"] {
    min-height: {{CONTROL_H_COMPACT_BUTTON_CONTENT}};
}
/* Save + Save-As share one secondary chip. Inner controls keep the same
 * compact height as neighboring toolbar buttons; the caret is not a second
 * labeled action. */
Toolbar QWidget#toolbarSaveSplit {
    background-color: transparent;
    border: none;
}
Toolbar QPushButton#toolbarSaveMain {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    padding-left: 10px;
    padding-right: 4px;
    border-right-width: 0;
}
Toolbar QPushButton#toolbarSaveCaret {
    min-height: {{CONTROL_H_COMPACT_BUTTON_CONTENT}};
    padding: 2px 2px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}
Toolbar QPushButton[role="panel-toggle"] {
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background-color: transparent;
}
Toolbar QPushButton[role="panel-toggle"]:hover {
    background-color: #f5f7fb;
    border-color: #dfe5ee;
}
Toolbar QPushButton[role="panel-toggle"]:checked {
    background-color: #e8efff;
    border-color: #1769e0;
    border-radius: 3px;
}
Toolbar QPushButton[segment="time"],
Toolbar QPushButton[segment="fft"],
Toolbar QPushButton[segment="fft_time"],
Toolbar QPushButton[segment="frf"],
Toolbar QPushButton[segment="order"] {
    min-width: 60px;
    min-height: 24px;
    margin: 0 1px;
    padding: 2px 10px;
    border: none;
    border-radius: 6px;
    background-color: transparent;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}
Toolbar QPushButton[segment][compact="true"] {
    min-width: 28px;
    padding: 2px 6px;
}
Toolbar QPushButton[segment]:hover {
    background-color: #eef2f7;
    color: #334155;
}
Toolbar QPushButton[segment]:checked {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 1 #edf5ff
    );
    color: #1769e0;
    /* Base segment rules use border:none; longhands recreate the frame
     * without the border: shorthand that would zero the 6px radius. */
    border-width: 1px;
    border-style: solid;
    border-color: #2d7ff9;
}
QWidget#modeSegment {
    padding: 2px;
    background-color: transparent;
}
/* The toolbar has three peer zones: file actions, analysis mode, and
 * brand/panel controls.  The mode zone is sized by its contents; its two
 * equal QHBoxLayout gaps place the boundary markers symmetrically rather than
 * relying on hand-tuned absolute offsets. */
Toolbar QFrame#toolbarModeZone {
    background-color: #fbfcff;
    border-radius: 7px;
}
Toolbar QFrame#modeZoneDivider {
    background-color: #fbfcff;
    border-left: 1px solid #e4eaf2;
    border-right: 1px solid #e4eaf2;
    border-radius: 3px;
}
Toolbar QFrame#modeZoneDividerTick {
    background-color: #2d7ff9;
    border: none;
    border-radius: 2px;
}
Toolbar QFrame#modeActiveDot {
    background-color: #1677ff;
    border: 1px solid #ffffff;
    border-radius: 3px;
}

/* Batch keeps its equal-width, text-only choices, but uses the same analysis
 * mode language as the top toolbar: a restrained pale-blue zone, symmetrical
 * boundary markers, and one raised active choice. */
QWidget#BatchMethodGroup {
    background-color: {{CONTROL_TRACK}};
    border: 1px solid {{CONTROL_TRACK_LINE}};
    border-radius: 7px;
}
QWidget#BatchMethodSegment {
    background-color: transparent;
}
QWidget#BatchMethodGroup QPushButton[batchMethod] {
    /* Retain Batch's existing touch target; only the visual language changes
     * here, not the vertical rhythm of the analysis panel. */
    /* Preserve the prior 34px outer button: 24 content + 4px padding × 2
     * + 1px transparent border × 2.  Checked only swaps colours. */
    min-height: 24px;
    margin: 0;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
    font-size: 13px;
    font-weight: 700;
}
QWidget#BatchMethodGroup QPushButton[batchMethod]:hover {
    background-color: transparent;
    color: {{CONTROL_TEXT}};
}
QWidget#BatchMethodGroup QPushButton[batchMethod]:checked {
    background-color: {{CONTROL_SURFACE_TOP}};
    color: {{CONTROL_TEXT_ON_SELECT}};
    border-color: {{CONTROL_SELECT_LINE}};
}
QFrame#BatchMethodZoneDivider {
    background-color: #fbfcff;
    border-left: 1px solid #e4eaf2;
    border-right: 1px solid #e4eaf2;
    border-radius: 3px;
}
QFrame#BatchMethodZoneDividerTick {
    background-color: #2d7ff9;
    border: none;
    border-radius: 2px;
}
QFrame#BatchMethodActiveDot {
    background-color: #1677ff;
    border: 1px solid #ffffff;
    border-radius: 3px;
}

/* Acquisition Cockpit v3 shell. These selectors are object-name/property
 * scoped so Analyzer's Toolbar and global QPushButton rules keep their
 * existing cascade. */
QFrame#cockpitToolbarBand {
    min-height: 50px;
    max-height: 50px;
    padding: 0;
    border-bottom: 1px solid #eef2f7;
    background-color: #ffffff;
}
QFrame#cockpitToolbarBand QPushButton,
QFrame#cockpitToolbarBand QToolButton {
    min-height: 28px;
    max-height: 36px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}
QFrame#cockpitToolbarBand QPushButton[cockpitAction="connect"] {
    min-height: 32px;
    max-height: 32px;
    padding: 0 20px;
    border-radius: 8px;
    background-color: #1769e0;
    border-color: #1769e0;
    color: #ffffff;
    font-size: 13px;
}
QFrame#cockpitToolbarBand QPushButton[cockpitAction="record"],
QFrame#cockpitToolbarBand QPushButton[cockpitAction="stop"] {
    min-height: 32px;
    max-height: 32px;
    padding: 0 18px;
    border-radius: 8px;
    background-color: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
    font-size: 13px;
}
QFrame#cockpitToolbarBand QPushButton[cockpitAction="disabled"] {
    min-height: 32px;
    max-height: 32px;
    padding: 0 18px;
    border-radius: 8px;
    color: #94a3b8;
    background-color: #f5f7fb;
    border-color: #eef2f7;
}
QWidget#cockpitToolbarSpacer {
    background-color: transparent;
    border: none;
}
QFrame#cockpitToolbarSeparator {
    min-width: 1px;
    max-width: 1px;
    min-height: 22px;
    max-height: 22px;
    background-color: #dfe5ee;
    border: none;
}
QToolButton#cockpitSettingsButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0;
    border-radius: 6px;
}

QLabel#cockpitTransportStatusChip {
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
    border: 1px solid #dfe5ee;
    border-radius: 7px;
    background-color: #f8fafc;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
}
QLabel#cockpitTransportStatusChip[transportState="unconfigured"] {
    background-color: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
}
QLabel#cockpitTransportStatusChip[transportState="configured"] {
    background-color: #ecfdf5;
    border-color: #a7f3d0;
    color: #065f46;
}

QFrame#cockpitSelector,
QFrame#cockpitSelectorA2l,
QFrame#cockpitSelectorOutput,
QPushButton#cockpitSelectorA2l,
QPushButton#cockpitSelectorOutput {
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    border: 1px solid #dfe5ee;
    border-radius: 6px;
    background-color: #ffffff;
    text-align: left;
}
QFrame#cockpitSelector:hover,
QFrame#cockpitSelectorA2l:hover,
QFrame#cockpitSelectorOutput:hover,
QPushButton#cockpitSelectorA2l:hover,
QPushButton#cockpitSelectorOutput:hover {
    border-color: #b7c4d3;
    background-color: #fbfdff;
}
QFrame#cockpitSelector:disabled,
QPushButton#cockpitSelectorOutput:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #eef2f7;
}
QFrame#cockpitSelector QLabel#cockpitSelectorKey,
QFrame#cockpitSelectorA2l QLabel#cockpitSelectorKey,
QFrame#cockpitSelectorOutput QLabel#cockpitSelectorKey,
QPushButton#cockpitSelectorA2l QLabel#cockpitSelectorKey,
QPushButton#cockpitSelectorOutput QLabel#cockpitSelectorKey {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QFrame#cockpitSelector QLabel#cockpitSelectorValue,
QFrame#cockpitSelectorA2l QLabel#cockpitSelectorValue,
QFrame#cockpitSelectorOutput QLabel#cockpitSelectorValue,
QPushButton#cockpitSelectorA2l QLabel#cockpitSelectorValue,
QPushButton#cockpitSelectorOutput QLabel#cockpitSelectorValue {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#cockpitSelectorA2l QLabel#cockpitSelectorCaret,
QPushButton#cockpitSelectorOutput QLabel#cockpitSelectorCaret {
    color: #64748b;
    font-size: 10px;
}

QWidget#cockpitModeSegment {
    min-height: 32px;
    max-height: 32px;
    padding: 2px;
    border: 1px solid {{CONTROL_TRACK_LINE}};
    border-radius: 7px;
    background-color: {{CONTROL_TRACK}};
}
QWidget#cockpitModeSegment QPushButton[cockpitMode] {
    min-width: 56px;
    min-height: 26px;
    max-height: 26px;
    margin: 0 1px;
    padding: 0 14px;
    border: 1px solid transparent;
    border-radius: 5px;
    background-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
}
QWidget#cockpitModeSegment QPushButton[cockpitMode]:hover {
    color: {{CONTROL_TEXT}};
    background-color: transparent;
}
QWidget#cockpitModeSegment QPushButton[cockpitMode]:checked {
    color: {{CONTROL_TEXT_ON_SELECT}};
    background-color: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
}

QLabel#cockpitRecIndicator {
    min-height: 32px;
    max-height: 32px;
    padding: 0 14px;
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #f8fafc;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}
QLabel#cockpitRecIndicator[recState="off"] {
    background-color: #f8fafc;
    border-color: #dfe5ee;
    color: #64748b;
}
QLabel#cockpitRecIndicator[recState="recording"] {
    background-color: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
}
QLabel#cockpitRecIndicator[recState="warn"] {
    background-color: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
}
QLabel#cockpitRecIndicator[recState="error"] {
    background-color: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
}

QFrame#healthStrip {
    border: none;
    border-bottom: 1px solid #eef2f7;
    background-color: #f5f7fb;
}
QFrame#healthChip {
    min-height: 26px;
    max-height: 26px;
    padding: 0;
    border: 1px solid #dfe5ee;
    border-radius: 13px;
    background-color: #ffffff;
}
QFrame#healthChip[level="green"] {
    border-color: #bbf7d0;
    background-color: #f0fdf4;
}
QFrame#healthChip[level="yellow"] {
    border-color: #fde68a;
    background-color: #fffbeb;
}
QFrame#healthChip[level="red"] {
    border-color: #fecaca;
    background-color: #fef2f2;
}
QFrame#healthChip[level="off"] {
    border-color: #e2e8f0;
    background-color: #f8fafc;
}
QLabel#healthChipLed {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background-color: #94a3b8;
}
QLabel#healthChipLabel {
    color: #334155;
    font-size: 11px;
    font-weight: 800;
}
QLabel#healthChipValue {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QLabel#healthSummary {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#healthDisconnectButton {
    min-height: 24px;
    padding: 2px 8px;
}

QFrame#leftPane {
    border: none;
    border-right: 1px solid #eef2f7;
    background-color: #ffffff;
}
QListWidget#measurementList::indicator {
    width: 0;
    height: 0;
}
QFrame#measurementRow {
    border: none;
    background-color: transparent;
}
QLabel#measurementName {
    color: #111827;
    font-size: 12px;
    font-weight: 650;
}
QLabel#measurementDetail {
    color: #64748b;
    font-size: 10px;
    font-weight: 500;
}
QLabel#measurementEventPrefix {
    color: #475569;
    font-size: 12px;
    font-weight: 800;
}
/* Tighter padding and type than the standard field, but deliberately NOT a
 * tighter corner: every combo in the app shares one 7px radius, so the
 * family reads as a single control regardless of row height.
 *
 * Spelled out rather than left to cascade from the input rule at the top:
 * this block sets the `border` shorthand, and Qt re-resolves the whole
 * border box from the winning rule, so an omitted radius renders as 0 —
 * measured, the arc came back at 0.80 of the left corners' ink. */
QComboBox#measurementEventSelect,
QComboBox#batchEventSelect {
    min-height: 24px;
    padding: 1px 6px;
    border: 1px solid #dfe5ee;
    border-radius: 7px;
    background-color: #ffffff;
    color: #111827;
    font-size: 11px;
    font-weight: 600;
}
QComboBox#measurementEventSelect:disabled,
QComboBox#batchEventSelect:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #eef2f7;
}
QPushButton#filterChip,
QToolButton#filterChip,
QCheckBox#filterChip {
    min-height: 22px;
    max-height: 22px;
    padding: 0 9px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    background-color: #f8fafc;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#filterChip:hover,
QToolButton#filterChip:hover,
QCheckBox#filterChip:hover {
    background-color: #eef2f7;
    border-color: #b7c4d3;
}
QPushButton#filterChip:checked,
QToolButton#filterChip:checked,
QCheckBox#filterChip:checked {
    color: #0f3f8f;
    background-color: #e8efff;
    border-color: #93b4ef;
}
QPushButton#filterChip:disabled,
QToolButton#filterChip:disabled,
QCheckBox#filterChip:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #eef2f7;
}
QCheckBox#filterChip::indicator {
    width: 0;
    height: 0;
}
QFrame#leftBatchBar {
    min-height: 32px;
    padding: 5px 8px;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    background-color: #eff6ff;
    color: #0f3f8f;
}

QWidget#cockpitDisconnectedCanvas {
    border: 1px dashed #cbd5e1;
    border-radius: 10px;
    background-color: #f8fafc;
}
QWidget#cockpitDisconnectedCanvas QLabel#cockpitDisconnectedTitle {
    color: #111827;
    font-size: 16px;
    font-weight: 800;
}
QWidget#cockpitDisconnectedCanvas QLabel#cockpitDisconnectedCopy {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}
QWidget#cockpitDisconnectedCanvas QPushButton[cockpitAction="connect"] {
    min-height: 32px;
    padding: 4px 14px;
    background-color: #1769e0;
    border-color: #1769e0;
    color: #ffffff;
}

QFrame#liveSignalCard {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
}
QFrame#liveSignalCard[recording="true"] {
    border-left: 1px solid #dc2626;
}
QLabel#liveCardSwatch {
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
    border-radius: 5px;
    background-color: #2563eb;
}
QLabel#liveCardName {
    color: #111827;
    font-size: 12px;
    font-weight: 700;
}
QLabel#liveCardUnit,
QLabel#liveCardRaster,
QLabel#liveCardStats {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QLabel#liveCardValue {
    color: #111827;
    font-size: 16px;
    font-weight: 800;
}
QFrame#liveSignalCard[focusState="active"] {
    border-color: #1769e0;
    background-color: #f8fbff;
}
QFrame#liveSignalCard[focusState="context"] {
    border-color: #e2e8f0;
}
QPushButton#liveFocusPreviousButton,
QPushButton#liveFocusNextButton,
QPushButton#liveFocusCollapseButton {
    min-height: 22px;
    padding: 1px 6px;
    border: 1px solid #bfd4f8;
    border-radius: 5px;
    background-color: #ffffff;
    color: #1769e0;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#liveFocusCollapseButton {
    color: #475569;
    border-color: #d7dee8;
}

/* Live monitor pinned-count bar (2026-07-08 §G6). */
#liveMonitorSummary { padding: 4px 12px; color: #6b7280; }

QFrame#liveFocusShell {
    border-bottom: 1px solid #dbeafe;
    background-color: #f5f9ff;
}
QLabel#liveFocusBar {
    color: #1f3f77;
    font-size: 12px;
    font-weight: 700;
}
QPushButton#liveFocusBackButton {
    min-height: 28px;
    padding: 3px 12px;
    border: 1px solid #bfd4f8;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1769e0;
    font-weight: 700;
}

QFrame#rightPanelPage {
    border: none;
    border-left: 1px solid #eef2f7;
    background-color: #ffffff;
}
QFrame#rightMetricSection {
    border: none;
    border-bottom: 1px solid #eef2f7;
    border-radius: 0;
    background-color: #ffffff;
}
QFrame#rightMetricSection QLabel#rightMetricTitle {
    color: #111827;
    font-size: 12px;
    font-weight: 800;
}
QFrame#rightMetricSection QLabel#rightMetricValue,
QFrame#rightMetricSection QLabel#rightMetricDetail {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}
QFrame#rightVerdictBanner {
    min-height: 34px;
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #f8fafc;
}
QFrame#rightVerdictBanner QLabel {
    color: #475569;
    font-weight: 800;
}
QFrame#rightVerdictBanner[verdict="ready"] {
    background-color: #f0fdf4;
    border-color: #bbf7d0;
}
QFrame#rightVerdictBanner[verdict="ready"] QLabel {
    color: #166534;
}
QFrame#rightVerdictBanner[verdict="warn"] {
    background-color: #fffbeb;
    border-color: #fde68a;
}
QFrame#rightVerdictBanner[verdict="warn"] QLabel {
    color: #92400e;
}
QFrame#rightVerdictBanner[verdict="error"] {
    background-color: #fef2f2;
    border-color: #fecaca;
}
QFrame#rightVerdictBanner[verdict="error"] QLabel {
    color: #991b1b;
}

/* ============ Left navigator ============ */
FileNavigator {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 7px;
}
QWidget#fileArea {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 6px;
}
QWidget#channelCard {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 6px;
}
QWidget#channelCard[dropActive="true"] {
    background-color: #f5f8ff;
    border-width: 2px;
    border-color: #1769e0;
}
QScrollArea#fileScroll {
    background-color: transparent;
    border: none;
}
QScrollArea#fileScroll > QWidget > QWidget { background-color: transparent; }

/* Pane-level heading — 13/700, breathe via padding-right for tracking */
QLabel#paneHeader {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
    padding-right: 6px;
}
/* Numeric count — no fill, colored text only */
QLabel#paneCount {
    min-width: 14px;
    padding: 0 4px;
    border: none;
    background-color: transparent;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}

/* File rows — every card carries its own outline so idle / hover / active
 * differ by border tone + background, not by "frame vs no frame". */
#fileRow {
    border: 1px solid #dfe5ee;
    border-radius: 10px;
    background-color: #ffffff;
}
#fileRow:hover {
    border-color: #b7c4d3;
    background-color: #ffffff;
}
#fileRow[active="true"] {
    /* Selection is shown by the light-blue tint alone. Keep the card outline a
     * NEUTRAL gray here (not blue) so the selected card reads as a soft tint
     * rather than a hard blue frame. */
    border-color: #b7c4d3;
    background-color: #f5f8ff;
}

QLabel#fileRowName {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}
QLabel#fileRowMeta {
    color: #64748b;
    font-size: 11px;
}

QLineEdit#channelSearch {
    min-height: {{CONTROL_H_BASE_INPUT_CONTENT}};
    background-color: #ffffff;
}

/* Channel tree — remove zebra stripe + flat header.
 * Horizontal item padding stays 0: the leaf delegate owns checkbox / Pts
 * insets from visualRect. Non-zero QSS padding made macOS selected
 * checkable rows shift relative to siblings. */
QTreeWidget#channelTree {
    border: 1px solid #eef2f7;
    border-radius: 9px;
    background-color: #ffffff;
    alternate-background-color: #ffffff;
    outline: none;
}
QTreeWidget#channelTree::item {
    min-height: 24px;
    /* Vertical padding here shortens the delegate fill relative to the
     * branch gutter, so keep it 0. Horizontal padding stays 0 for the
     * same reason as the comment on the tree rule above. */
    padding: 0;
}
QTreeWidget#channelTree::item:selected {
    background-color: #b7d3f2;
    color: #111827;
    /* Do not set border-radius on ::item:selected or ::branch:selected.
     * Qt rounds each cell and the branch slot independently, so a selected
     * file row became a circle around the expander and a pill around the
     * display-column close/eye. Keep the fill rectangular; the tree widget
     * still owns the 9px outer radius. */
}
QTreeWidget#channelTree::branch:selected {
    background-color: #b7d3f2;
}

QHeaderView::section {
    min-height: 24px;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #eef2f7;
    background-color: transparent;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}

/* ============ Inspector ============ */
Inspector {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 7px;
}
QScrollArea#inspectorScroll {
    border: none;
    background-color: transparent;
}
QScrollArea#inspectorScroll > QWidget > QWidget {
    background-color: transparent;
}
QWidget#inspectorScrollBody {
    background-color: #fafbfc;
    border: none;
}
Inspector QWidget[inspectorFieldHost="true"] {
    background-color: transparent;
}

/* QGroupBox: no frame. Separation comes from a 12/600 title with a
 * 1px hairline underline (R3 #3-B compactification). The underline
 * replaces the heavier 13/700 typography while keeping enough air
 * between the underline and the first control row. */
Inspector QGroupBox {
    margin-top: 6px;
    padding: 18px 2px 8px;
    border: none;
    border-radius: 0;
    background-color: transparent;
    font-weight: 600;
}
/* 坐标轴设置: drop the 2px right padding so the fluid range editors line up
 * with the card's form fields (色图 / 信号) on the right edge. */
Inspector QGroupBox#axisSettingsGroup {
    padding-right: 0;
}
/* Title-less 谱参数 / 时频参数 group nested inside a _CollapsibleParamSection:
 * the section header already renders the title, so drop the empty title band
 * (6px margin + 18px top padding) and carry a hairline divider above the
 * expanded detail fields — matches docs/mockups/tf-params-merged-section.html. */
Inspector QGroupBox#paramsSectionBody {
    margin-top: 0;
    padding-top: 9px;
    border-top: 1px solid #dfe5ee;
}
/* The merged preset/params section sits inside the lower params card.
 * Its wrapper widgets must not repaint the global QWidget/QFrame white or
 * base-gray surfaces over that card; leave the card surface visible through
 * the header, persistent preset strip, and expanded body. */
Inspector QWidget#inspectorParamSection,
Inspector QWidget#inspectorParamHeader,
Inspector QWidget#inspectorParamPersistentHost,
Inspector QWidget#inspectorPresetBar,
Inspector QFrame#inspectorParamBody {
    background-color: transparent;
}
Inspector QToolButton#inspectorCollapser {
    text-align: left;
    padding: 4px 6px;
    font-weight: 600;
    border: none;
    background-color: transparent;
}
Inspector QToolButton#inspectorCollapser:hover {
    background-color: #eef2f7;
}
Inspector QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    right: 0;
    padding: 2px 0 6px 0;
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border-bottom: 1px solid #dfe5ee;
}

/* The same underline rhythm for our custom group-header rows
 * (QFrame#inspectorGroupHeader) so the visual matches across the
 * native QGroupBox flavour and the QFrame-with-button flavour used
 * when a group title needs an inline action button (R3 #9). */
Inspector QFrame#inspectorGroupHeader {
    border: none;
    border-bottom: 1px solid #dfe5ee;
    background-color: transparent;
    padding: 2px 0;
}
Inspector QFrame#inspectorGroupHeader QLabel#inspectorGroupTitle {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}

/* 2026-04-26 R3 紧凑化 fix-2:
 * The sig-card QFrames (fftSignalCard / orderSignalCard / fftTimeSignalCard)
 * are wrappers that group "分析信号" / "信号源" header + fields. They now render
 * as white inner cards on the neutral Inspector body, while preserving the
 * paired object-name rule required by the wrapper-QFrame lesson.
 */
Inspector QFrame#fftSignalCard,
Inspector QFrame#orderSignalCard,
Inspector QFrame#fftTimeSignalCard {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 6px;
    padding: 0;
}

/* 2026-06-22 卡片重组: timeDomainSettingsCard is now a TRANSPARENT outer host
 * that stacks the persistent top (which owns the two white cards below) and
 * the time contextual (「绘图」). The white surfaces moved to the inner
 * timeXaxisCard / timeRangeFilterCard so the two settings cards read as
 * independent panels instead of one combined block. */
Inspector QFrame#timeDomainSettingsCard {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}

/* The two independent time-domain settings cards: ① 横坐标 and
 * ② 时间范围·滤波. Same white-card treatment as the analysis sig-cards. */
Inspector QFrame#timeXaxisCard,
Inspector QFrame#timeRangeFilterCard {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 6px;
    padding: 0;
}

Inspector QWidget#timeRangeToggleRow,
Inspector QWidget#inspectorPairField {
    background-color: transparent;
    border: none;
}

/* 2026-06-13 分析信号/谱参数 split: each analysis contextual is now a
 * transparent host for two stacked, full-width cards — the white
 * analysis-signal card (sig_card) on top and the white parameter card
 * (params_card) below, separated by an 8px #f5f7fb gutter (root spacing).
 * The visible borders/backdrops live on those two cards so they read as two
 * independent panels instead of the old card-inside-a-card; dropping the
 * outer border also lets the analysis-signal card span the pane edge-to-edge
 * (the wider frame the user asked for). */
QWidget#fftContextual,
QWidget#fftTimeContextual,
QWidget#orderContextual,
QWidget#frfContextual {
    border: none;
    background-color: transparent;
}

/* Lower parameter panel (谱参数 / 时频参数 + 坐标轴设置 + 预设 + action). */
Inspector QFrame#fftParamsCard,
Inspector QFrame#fftTimeParamsCard,
Inspector QFrame#orderParamsCard,
Inspector QFrame#frfSignalCard,
Inspector QFrame#frfParamsCard,
Inspector QFrame#frfDisplayCard,
Inspector QFrame#frfFactsCard {
    background-color: #ffffff;
    border: 1px solid #dbe2eb;
    border-radius: 6px;
}

/* Resident 有效事实 block (spec §5.3/§13): read-only measured numbers plus
 * whatever the numeric core warned about. Stale = the compute parameters
 * moved on but nothing was recomputed, so the numbers stay readable and only
 * drop to the project's existing muted token. The warning list reuses the
 * batch preview's amber trio (batchPreviewWarnings) — same meaning, same
 * colours, no new token. */
Inspector QLabel#frfEffectiveFacts {
    color: #334155;
    font-size: 11px;
    background: transparent;
}
Inspector QLabel#frfFactsPlaceholder {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
}
Inspector QLabel#frfEffectiveFacts[factsState="stale"] {
    color: #94a3b8;
}
Inspector QFrame#frfFactsCard QLabel[factsRole="warning"] {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 6px;
    color: #92400e;
    padding: 6px 10px;
    font-size: 11px;
}
/* A stale warning describes numbers that are no longer current, so it drops
 * out of the live amber alongside the facts it belongs to — otherwise it
 * keeps competing for attention with whatever the next run reports. */
Inspector QFrame#frfFactsCard QLabel[factsRole="warning"][factsState="stale"] {
    background-color: #f8fafc;
    border-color: #e2e8f0;
    color: #94a3b8;
}

Inspector QLabel#frfDelayRetention {
    color: #64748b;
    font-size: 11px;
    background: transparent;
    padding-left: 88px;
}

Inspector QLabel#frfSisoBadge {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
}
Inspector QFrame#frfSignalRow,
Inspector QFrame#frfSystemFlow {
    border: none;
    background: transparent;
}
Inspector QLabel#frfSignalRole {
    min-width: 44px;
    color: #1f2937;
    font-weight: 700;
    background: transparent;
}
Inspector QLabel#frfInputDot { color: #2563eb; background: transparent; }
Inspector QLabel#frfOutputDot { color: #f97316; background: transparent; }
Inspector QLabel#frfFlowInput,
Inspector QLabel#frfFlowOutput {
    color: #64748b;
    font-size: 11px;
    background: transparent;
}
Inspector QLabel#frfFlowArrow {
    color: #1769e0;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}
Inspector QLabel#frfFlowBlock {
    min-height: 28px;
    padding: 2px 6px;
    border: 1px solid #9cbbe9;
    border-radius: 6px;
    background: #f2f7ff;
    color: #245aa5;
    font-size: 11px;
    font-weight: 700;
}
QFrame#frfSegmentChoice {
    border: 1px solid {{CONTROL_TRACK_LINE}};
    border-radius: 7px;
    background: {{CONTROL_TRACK}};
}
QFrame#frfSegmentChoice QPushButton[role="frf-segment"] {
    /* Keep the old 28px outer segment after reserving a 1px border. */
    min-height: 24px;
    padding: 1px 5px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: {{CONTROL_TEXT_MUTED}};
    font-weight: 700;
}
QFrame#frfSegmentChoice QPushButton[role="frf-segment"]:hover {
    background: transparent;
    color: {{CONTROL_TEXT}};
}
QFrame#frfSegmentChoice QPushButton[role="frf-segment"]:checked {
    background: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
/* The mapping swap is a textual action, not icon-only toolbar chrome.
 * Its own height floor must win over the compact [role="tool"] rule. */
Inspector QPushButton[role="frf-swap"] {
    min-height: 19px;
    padding: 1px 8px;
}

/* The axis-settings grid is always hosted inside the params_card, so
 * its blank cells stay transparent and let the white card show through —
 * no separate white table rows over the panel. */
Inspector QWidget#axisRow,
Inspector QWidget#axisRowLine,
Inspector QWidget#axisAutoCell,
Inspector QWidget#axisRangeHost,
Inspector QWidget#axisRangeSummaryPage,
Inspector QWidget#axisManualRangePage,
Inspector QWidget#axisUnitLine,
Inspector QWidget#axisHeaderRow,
Inspector QWidget#axisHeaderRange {
    background-color: transparent;
}
/* 自动 / 最小 / 最大 column headers above the axis grid — muted + small. */
Inspector QLabel[axisHeader="true"] {
    color: #97a1b2;
    font-size: 11px;
    font-weight: 500;
    background-color: transparent;
}

/* Inspector numeric fields are typed inputs, not stepper controls. Keep
 * QComboBox drop-down arrows above; only spinbox stepper chrome is
 * removed. Selectors are scoped to [compact="true"] (Wave 5, P8-O1) so
 * the global rules above and these Inspector overrides are gated by the
 * same dynamic property — see compact_spinbox.no_buttons / __init__. */
Inspector QSpinBox[compact="true"],
Inspector QDoubleSpinBox[compact="true"] {
    padding-right: 8px;
}
Inspector QSpinBox[compact="true"]::up-button,
Inspector QDoubleSpinBox[compact="true"]::up-button,
Inspector QSpinBox[compact="true"]::down-button,
Inspector QDoubleSpinBox[compact="true"]::down-button {
    width: 0;
    border: none;
    image: none;
}
Inspector QSpinBox[compact="true"]::up-arrow,
Inspector QDoubleSpinBox[compact="true"]::up-arrow,
Inspector QSpinBox[compact="true"]::down-arrow,
Inspector QDoubleSpinBox[compact="true"]::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* ============ dB reference compound control (2026-07-12 db-reference) ====
 * Scoped strictly to objectName — no generic QToolButton/QLineEdit/
 * QDoubleSpinBox rule is touched (Task 3 constraint). Root + source line
 * stay transparent so the surrounding fftParamsCard/fftTimeParamsCard/
 * orderParamsCard white surface reads through continuously (spec §17.2). */
#dbReferenceControl {
    background-color: transparent;
    border: none;
}
#dbReferenceEditor[error="true"] {
    border-color: #dc2626;
    background-color: #fdf2f2;
}
#dbReferenceManageButton {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #fafbfc;
    color: #374151;
}
#dbReferenceManageButton:hover {
    border-color: #b7c4d3;
    background-color: #eef4fb;
}
#dbReferenceManageButton:pressed {
    background-color: #dbe9fb;
}
/* Auto (blue) / Manual (amber) badge — a small 16px circle anchored to the
 * manage button's corner; only ONE extra visual accent (spec §17.2: no
 * second primary-color block besides the existing control blue). Amber
 * reuses the project's existing warning token (#d97706, see toastIcon). */
#dbReferenceModeBadge {
    border: 2px solid #ffffff;
    border-radius: 8px;
    background-color: #1769e0;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
}
#dbReferenceModeBadge[mode="manual"] {
    background-color: #d97706;
}
#dbReferenceSourceLabel {
    color: #64748b;
    font-size: 11px;
    background-color: transparent;
}

/* ============ dB reference defaults manager dialog =======================
 * Reuses ChartOptionsDialog/SheetSurface visual language — no frameless web
 * window (spec §17.2). */
QDialog#DbReferenceDefaultsDialog {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #f5f7fb;
}
QDialog#DbReferenceDefaultsDialog QLabel#dbReferenceDialogTitle {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
    background-color: transparent;
}
QDialog#DbReferenceDefaultsDialog QLabel#dbReferenceDialogSubtitle {
    color: #64748b;
    font-size: 12px;
    background-color: transparent;
}
QDialog#DbReferenceDefaultsDialog QToolButton#dbReferenceDialogClose {
    border: none;
    border-radius: 7px;
    background-color: transparent;
}
QDialog#DbReferenceDefaultsDialog QToolButton#dbReferenceDialogClose:hover {
    background-color: #e8edf3;
}
QDialog#DbReferenceDefaultsDialog QWidget#dbReferenceDialogToggleRow {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
    /* The widget layout owns the real content inset; stylesheet padding alone
       does not move QLayout children away from this card's border. */
    padding: 0;
}
QDialog#DbReferenceDefaultsDialog QLabel#dbReferenceDialogToggleTitle {
    color: #111827;
    font-weight: 700;
    background-color: transparent;
}
QDialog#DbReferenceDefaultsDialog QLabel#dbReferenceDialogToggleDesc {
    color: #64748b;
    font-size: 11px;
    background-color: transparent;
}
QDialog#DbReferenceDefaultsDialog QLabel#dbReferenceDialogEffective {
    color: #315c98;
    font-size: 11px;
    background-color: transparent;
    padding-left: 2px;
}
QDialog#DbReferenceDefaultsDialog QTableWidget#dbReferenceDialogTable {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
    gridline-color: #eef2f7;
}
QDialog#DbReferenceDefaultsDialog QTableWidget#dbReferenceDialogTable QHeaderView::section {
    border: none;
    border-bottom: 1px solid #dfe5ee;
    background-color: #fafbfc;
    color: #64748b;
    font-weight: 600;
    padding: 4px 6px;
}
QDialog#DbReferenceDefaultsDialog QLabel#dbReferenceDialogError {
    color: #b42318;
    font-size: 11px;
    background-color: #fdf2f2;
    border: 1px solid #f1c9c4;
    border-radius: 6px;
    padding: 6px 8px;
}
/* Per-row 删除 buttons reuse the ChannelEditorDialog danger tokens
 * (#b42318 text / #f1c9c4 border / #fdf4f3 fill) so destructive row actions
 * read consistently across the app's dialogs. */
QDialog#DbReferenceDefaultsDialog QTableWidget#dbReferenceDialogTable QPushButton[role="danger"] {
    color: #b42318;
    border: 1px solid #f1c9c4;
    border-radius: 6px;
    background-color: #fdf4f3;
    padding: 2px 8px;
    font-size: 11px;
}
QDialog#DbReferenceDefaultsDialog QTableWidget#dbReferenceDialogTable QPushButton[role="danger"]:hover {
    border-color: #e3a8a1;
    background-color: #fbe9e7;
}

/* Preset slot buttons inside FFT/Order contextual */
QPushButton[role="preset-load"] {
    min-width: 46px;
    min-height: 26px;
    padding: 3px 4px;
    font-weight: 600;
}
QPushButton[role="preset-load"][filled="true"] {
    background-color: #ffffff;
    border-color: #b7c4d3;
    color: #0f3f8f;
}
QPushButton[role="preset-load"][applied="true"] {
    color: #0b73e7;
    background-color: #e8f1ff;
    border-color: #0b73e7;
    font-weight: 700;
}
QPushButton[role="preset-load"][applied="true"]:hover {
    background-color: #dcecff;
    border-color: #0a66d4;
}
QPushButton[role="preset-load"]:disabled {
    color: #a3aebd;
    background-color: transparent;
    border-style: dashed;
    border-color: #cdd5e0;
}
/* Unit recommendation is a corner badge only; the button body is reserved
   for the actually applied preset state. */
QLabel#presetRecommendBadge {
    color: #ffffff;
    background-color: #10b981;
    border: 1px solid #059669;
    border-radius: 7px;
    font-size: 9px;
    font-weight: 800;
}
QPushButton[role="preset-save"] {
    min-height: 22px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
    background-color: transparent;
    border-color: transparent;
}
QPushButton[role="preset-save"]:hover {
    color: #334155;
    background-color: #eef2f7;
    border-color: #dfe5ee;
}

/* ============ Toast (floating acknowledgement) ============ */
QFrame#toast {
    border: 1px solid #dfe5ee;
    border-radius: 10px;
    background-color: #ffffff;
}
QFrame#toast[level="success"] {
    border-color: #a7d4b1;
    background-color: #eaf7ee;
}
QFrame#toast[level="warning"] {
    border-color: #f0d090;
    background-color: #fdf6e3;
}
QFrame#toast[level="error"] {
    border-color: #e8a8a8;
    background-color: #fbecec;
}
QLabel#toastText {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#toastIcon {
    min-width: 18px;
    max-width: 18px;
    qproperty-alignment: AlignCenter;
    border-radius: 9px;
    color: #ffffff;
    background-color: #1769e0;
    font-weight: 700;
    font-size: 12px;
}
QLabel#toastIcon[level="success"] { background-color: #16a34a; }
QLabel#toastIcon[level="warning"] { background-color: #d97706; color: #ffffff; }
QLabel#toastIcon[level="error"]   { background-color: #dc2626; }

Inspector QPushButton[role="choice"] {
    min-height: 28px;
    font-weight: 700;
}
Inspector QPushButton[role="choice"]:checked {
    background-color: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
Inspector QPushButton[role="primary"] { min-height: {{CONTROL_H_CTA_BUTTON_CONTENT}}; }

/* ============ Chart stack ============ */
ChartStack { background-color: #ffffff; border: 1px solid #dbe2eb; border-radius: 7px; }

QWidget#timeDomainPage {
    background-color: transparent;
}

QWidget#timeViewBottomDock {
    background-color: #fbfcff;
    border-top: 1px solid #dbe3ee;
    /* The dock is the LAST child of the ChartStack card and spans its full
     * width, so its opaque fill lands on the card's rounded bottom corners.
     * Without matching radii it squares them off (and the shell background
     * stops showing through) — see tests/ui/test_surface_layering.py
     * ::test_surface_top_bottom_and_panels_render_rounded_corners. Keep in
     * sync with ChartStack's border-radius above. */
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

QWidget#chartCard {
    border: 1px solid #d3dbe6;
    border-radius: 6px;
    background-color: #ffffff;
}

/* Side-by-side compare: the focus cue is a 3px overlay accent strip painted
 * by _ChartCard.set_focus_marker (raised above the canvas), NOT a QSS card
 * border — a card border is hidden behind the full-bleed pyqtgraph canvas. So
 * the focused card keeps the plain #chartCard look here; no frame, no tint,
 * no data-area dimming. */
QWidget#chartCard[focused="true"] {
    border-radius: 6px;
    background-color: #ffffff;
}

/* 2026-06-13 slice info panel — sits in the colorbar column below the
 * colorbar (the slice plot's right edge is pulled in to align its time axis
 * with the heatmap, freeing this column). Holds the X/Y direction switch +
 * the current fixed value / meaning. */
QWidget#slicePanel {
    background-color: #fbfcff;
    border: 1px solid #e1e7f0;
    border-radius: 7px;
}
QWidget#sliceDirToggle {
    background-color: {{CONTROL_TRACK}};
    border: 1px solid {{CONTROL_TRACK_LINE}};
    border-radius: 8px;
}
QWidget#sliceDirToggle QPushButton[role="slice-seg"] {
    border: 1px solid transparent;
    background: transparent;
    color: {{CONTROL_TEXT_MUTED}};
    font-size: 9px;
    font-weight: 700;
    /* Keep the old 18px outer segment after reserving a stable border. */
    min-height: 16px;
    padding: 0 3px;
    border-radius: 7px;
}
QWidget#sliceDirToggle QPushButton[role="slice-seg"]:hover {
    background-color: transparent;
    color: {{CONTROL_TEXT}};
}
QWidget#sliceDirToggle QPushButton[role="slice-seg"]:checked {
    background-color: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}
QLabel#sliceHint {
    color: #33425c;
    font-size: 9px;
    background: transparent;
}

/* 2026-06-14 折叠下图后的底部细带（drawer 风格，复刻 #sidePanelStrip 淡色）。
 * #plotSplitDivider 仍画自身 1px 拖拽线。 */
QWidget#plotSplitDivider {
    background: transparent;
    border: none;
}
QFrame#plotCollapsedRail {
    background-color: #f3f5f8;
    border: none;
    border-top: 1px solid #e2e6eb;
}
QFrame#plotCollapsedRail:hover {
    background-color: #e7ecf2;
}

/* Chart toolbar - compact spacing & padding for the pyqtgraph toolbar. */
QToolBar#chartToolbar,
QWidget#chartToolbar {
    background-color: transparent;
    border: none;
    spacing: 1px;
    padding: 1px;
}
QToolBar#chartToolbar QToolButton,
QWidget#chartToolbar QToolButton {
    padding: 2px 4px;
}
QWidget#chartToolbar QToolButton#chartTickDensityButton {
    color: #334155;
    border: 1px solid #b7c8dc;
    border-radius: 7px;
    background-color: #ffffff;
    padding: 0;
}
QWidget#chartToolbar QToolButton#chartTickDensityButton:hover {
    color: #0b7af3;
    border-color: #0b7af3;
    background-color: #e7f1ff;
}
QWidget#chartToolbar QToolButton#chartTickDensityButton:pressed,
QWidget#chartToolbar QToolButton#chartTickDensityButton:focus,
QWidget#chartToolbar QToolButton#chartTickDensityButton:checked {
    color: #334155;
    border-color: #b7c8dc;
    background-color: #ffffff;
}
QWidget#chartToolbar QToolButton:disabled {
    border: 1px solid #e5eaf2;
    border-radius: 6px;
    background-color: #f8fafc;
}

QFrame#cursorPill {
    border: none;
    background: transparent;
    color: #111827;
}
QFrame#cursorPill QLabel#cursorPillPrimary {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QFrame#cursorPill QLabel#cursorPillDetail {
    background: transparent;
}
QPushButton#cursorPillToggle {
    background: rgba(100, 116, 139, 0.15);
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: 3px;
    color: #475569;
    font-size: 10px;
    font-weight: 700;
    padding: 0px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}
/* full mode reuses the base #cursorPillToggle chrome — do not restate
 * border: here (shorthand would zero the 3px radius). */
QPushButton#cursorPillToggle[cursorPillMode="mini"] {
    background: rgba(37, 99, 235, 0.14);
    border-color: rgba(37, 99, 235, 0.52);
    color: #2563eb;
}
QPushButton#cursorPillToggle[cursorPillMode="full"]:hover {
    background: rgba(100, 116, 139, 0.25);
}
QPushButton#cursorPillToggle[cursorPillMode="full"]:pressed {
    background: rgba(100, 116, 139, 0.40);
}
QPushButton#cursorPillToggle[cursorPillMode="mini"]:hover {
    background: rgba(37, 99, 235, 0.18);
}
QPushButton#cursorPillToggle[cursorPillMode="mini"]:pressed {
    background: rgba(37, 99, 235, 0.26);
}

StatsStrip {
    margin: 8px 10px 10px;
    border: 1px solid #eef2f7;
    border-radius: 10px;
    background-color: #ffffff;
}
StatsStrip QLabel { color: #475569; }
StatsStrip QTreeWidget {
    border: 1px solid #eef2f7;
    border-radius: 8px;
    background-color: #ffffff;
    alternate-background-color: #ffffff;
}

/* Drawers / popovers */
QDialog#DrawerSurface,
QDialog#SheetSurface {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #ffffff;
}
/* RebuildTimePopover: the rounded fill rides on an inner QFrame so the
 * translucent shell dialog shows transparent (not boxed) corners. */
QFrame#PopoverSurface {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #ffffff;
}
QFrame#PopoverSurface QLabel { color: #334155; }

QFrame#TickDensitySurface {
    border: 1px solid #b7c8dc;
    border-radius: 8px;
    background-color: #ffffff;
}
QFrame#TickDensitySurface QLabel#tickDensityTitle {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}
QFrame#TickDensitySurface QLabel#tickDensityScope {
    color: #64748b;
    font-size: 11px;
}
QFrame#TickDensitySurface QFrame#tickDensityPresetHost {
    background-color: {{CONTROL_TRACK}};
    border: 1px solid {{CONTROL_TRACK_LINE}};
    border-radius: 7px;
}
QFrame#TickDensitySurface QPushButton[role="tick-density-preset"] {
    min-height: 28px;
    border: 1px solid transparent;
    border-radius: 6px;
    background-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
    font-size: 12px;
    font-weight: 700;
}
QFrame#TickDensitySurface QPushButton[role="tick-density-preset"]:hover {
    border-color: transparent;
    background-color: transparent;
    color: {{CONTROL_TEXT}};
}
QFrame#TickDensitySurface QPushButton[role="tick-density-preset"]:checked {
    color: {{CONTROL_TEXT_ON_SELECT}};
    border-color: {{CONTROL_SELECT_LINE}};
    background-color: {{CONTROL_SURFACE_TOP}};
}
QFrame#TickDensitySurface QFrame#tickDensityAxisRow {
    background-color: transparent;
}
QFrame#TickDensitySurface QLabel#tickDensityAxisLabel {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
}
QFrame#TickDensitySurface QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background-color: #d9e5f5;
}
QFrame#TickDensitySurface QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border: 2px solid #0b7af3;
    border-radius: 7px;
    background-color: #ffffff;
}
QFrame#TickDensitySurface QSpinBox#tickDensitySpin {
    min-height: 24px;
    border: 1px solid #dbe5f1;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1e293b;
    font-weight: 700;
}
QFrame#TickDensitySurface QPushButton#tickDensityResetButton {
    min-height: 28px;
    border: 1px solid #dbe5f1;
    border-radius: 6px;
    background-color: #ffffff;
    color: #475569;
    font-size: 12px;
}
QFrame#TickDensitySurface QPushButton#tickDensityResetButton:hover {
    border-color: #b7c8dc;
    background-color: #f8fbff;
}

QDialog#ChartOptionsDialog {
    border: 1px solid #dfe5ee;
    border-radius: 12px;
    background-color: #f5f7fb;
}

QDialog#ChartOptionsDialog QLabel#chartOptionsTitle {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
    background-color: transparent;
}

QDialog#ChartOptionsDialog QLabel#chartOptionsSubtitle {
    color: #64748b;
    font-size: 12px;
    background-color: transparent;
}

QDialog#ChartOptionsDialog QTabWidget#chartOptionsTabs {
    background-color: #f5f7fb;
}

QDialog#ChartOptionsDialog QTabBar {
    background-color: #f5f7fb;
}

QDialog#ChartOptionsDialog QTabWidget::pane {
    border: 1px solid #dfe5ee;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

QDialog#ChartOptionsDialog QTabBar::tab {
    min-height: 24px;
    padding: 4px 14px;
    margin-right: 4px;
    border: 1px solid #dfe5ee;
    border-bottom-color: #dfe5ee;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
}

QDialog#ChartOptionsDialog QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0f3f8f;
    border-bottom-color: #ffffff;
}

QDialog#ChartOptionsDialog QFrame#chartOptionsGroup {
    border: 1px solid #d8e3f0;
    border-radius: 8px;
    background-color: #ffffff;
}

QDialog#ChartOptionsDialog QLabel#chartOptionsGroupTitle {
    color: #0f2749;
    font-weight: 700;
    background-color: transparent;
}

/* ============ Channel editor (narrow 方案 A drawer body) ============
 * Scoped to #ChannelEditorDialog so the create/danger button accents and
 * the three-band (file bar / scroll body / footer) chrome never leak into
 * the global QPushButton cascade. Tokens mirror the prototype:
 * create  = #0f3f8f text / #cdddf6 border / #f3f8ff fill
 * danger  = #b42318 text / #f1c9c4 border / #fdf4f3 fill
 * primary 确定 reuses the global [role="primary"] blue (#1769e0). */
QDialog#ChannelEditorDialog,
QDialog#DrawerSurface #ChannelEditorDialog {
    background-color: #ffffff;
}
#ChannelEditorDialog QWidget#channelEditorFileBar {
    border-bottom: 1px solid #eef2f7;
    background-color: #fbfcfe;
}
#ChannelEditorDialog QWidget#channelEditorFooter {
    border-top: 1px solid #eef2f7;
    background-color: #fbfcfe;
}
#ChannelEditorDialog QScrollArea#channelEditorScroll {
    border: none;
    background-color: #ffffff;
}
#ChannelEditorDialog QWidget#channelEditorBody {
    background-color: #ffffff;
}
/* Group titles: 12/600 with a 1px hairline underline (matches Inspector). */
#ChannelEditorDialog QGroupBox {
    margin-top: 6px;
    padding: 18px 0 4px;
    border: none;
    background-color: transparent;
    font-weight: 600;
}
#ChannelEditorDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    right: 0;
    padding: 2px 0 6px 0;
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border-bottom: 1px solid #dfe5ee;
}
#ChannelEditorDialog QLabel#channelEditorCount {
    color: #64748b;
    font-size: 12px;
    background-color: transparent;
}
/* 自定义表达式 row: monospace so ()/^/* read unambiguously, plus a dim
 * one-line cheatsheet under it (variables + the most-used functions). */
#ChannelEditorDialog QLineEdit#channelExprEdit {
    font-family: "SF Mono", "Menlo", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 12px;
}
/* Bare ? glyph next to the expression input — no chrome, just the accent
 * color as the "there is help here" cue. Hover shows the reference through
 * the app-wide glass tooltip; clicking pins it as a draggable card
 * (ui/expression_help.py), and the checked state deepens the glyph.
 * padding:0 + explicit min/max sizing keep the styled QToolButton's content
 * rect from collapsing (Qt would log QPainter::begin engine == 0). */
#ChannelEditorDialog QToolButton#channelExprHelp {
    color: #1769e0;
    border: none;
    background-color: transparent;
    padding: 0;
    min-width: 18px; max-width: 18px;
    min-height: 18px; max-height: 18px;
    font-size: 14px;
    font-weight: 700;
}
#ChannelEditorDialog QToolButton#channelExprHelp:hover,
#ChannelEditorDialog QToolButton#channelExprHelp:checked {
    color: #0f3f8f;
}
#ChannelEditorDialog QLabel#channelExprHint {
    color: #7b8794;
    font-size: 11px;
    font-weight: 400;
    background-color: transparent;
}
/* 导出/删除共用勾选列表（曾用 #channelDeleteList 多选高亮，已退役） */
#ChannelEditorDialog QListWidget#channelExportList {
    border: 1px solid #eef2f7;
    border-radius: 7px;
    background-color: #ffffff;
    outline: none;
}
#ChannelEditorDialog QListWidget#channelExportList::item {
    padding: 3px 6px;
    border-radius: 5px;
}
#ChannelEditorDialog QPushButton[role="create"] {
    color: #0f3f8f;
    border-color: #cdddf6;
    background-color: #f3f8ff;
}
#ChannelEditorDialog QPushButton[role="create"]:hover {
    border-color: #93b4ef;
    background-color: #e8efff;
}
#ChannelEditorDialog QPushButton[role="danger"] {
    color: #b42318;
    border-color: #f1c9c4;
    background-color: #fdf4f3;
}
#ChannelEditorDialog QPushButton[role="danger"]:hover {
    border-color: #e3a8a1;
    background-color: #fbe9e7;
}

/* Menus and status
 * Compact density (2026-08-10 Option A): align row height with combo/base
 * controls (~28 outer) instead of the old 38px items that dwarfed 24px kebabs.
 * Default right pad is 12 (no empty check gutter). Menus with checkable rows or
 * submenu arrows set dynamic property gutter="check" for padding-right 22.
 * pgContextMenu below keeps its own larger Precision Light metrics. */
QMenu {
    padding: 4px;
    border: 1px solid rgba(190, 205, 225, 210);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 238);
}
QMenu::item {
    min-height: 20px;
    padding: 4px 12px 4px 10px;
    border-radius: 6px;
}
QMenu[gutter="check"]::item {
    padding-right: 22px;
}
QMenu::item:selected {
    background-color: rgba(232, 239, 255, 230);
    color: #111827;
}
QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background-color: rgba(148, 163, 184, 155);
}

/* ---- TimeDomain right-click context menu (方案 A · Precision Light) ----
 * Native pyqtgraph QMenu reshaped in pg_canvases.redesign_pg_context_menu.
 * objectName 'pgContextMenu' is set on the assembled menu AND each promoted
 * submenu (网格 / 鼠标操作). White surface, hairline light border, comfortable
 * row height, light-blue selected state — kept distinct from data-series
 * colors. Rounded corners ride on WA_TranslucentBackground + this radius
 * (native shell rounding may be imperfect on some platforms — accepted, per
 * the design's native-path decision).
 * Long-form per-side padding (not the shorthand) so a later global QMenu
 * padding tweak cannot silently clobber one side
 * (lesson 2026-04-27-qss-padding-overrides-setcontentsmargins). */
QMenu#pgContextMenu {
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    border: 1px solid rgba(177, 195, 217, 200);
    border-radius: 14px;
    background-color: #ffffff;
}
QMenu#pgContextMenu::item {
    min-height: 30px;
    padding-top: 6px;
    padding-right: 30px;
    padding-bottom: 6px;
    padding-left: 14px;
    border-radius: 9px;
    color: #172033;
}
QMenu#pgContextMenu::item:selected {
    background-color: #e8efff;
    color: #0f3f8f;
}
QMenu#pgContextMenu::item:checked {
    color: #0f3f8f;
    font-weight: 600;
}
QMenu#pgContextMenu::separator {
    height: 1px;
    margin: 6px 12px;
    background-color: rgba(148, 163, 184, 90);
}

QStatusBar#surfaceStatusBar {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #dbe2eb;
    border-radius: 8px;
}

QStatusBar#surfaceStatusBar QLabel#plotRiskLabel {
    min-height: 20px;
    max-height: 22px;
    padding: 1px 8px;
    margin: 0 4px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

QStatusBar#surfaceStatusBar QLabel#plotRiskLabel[riskLevel="warning"] {
    color: #8a4b00;
    background-color: #fff7df;
    border-width: 1px;
    border-style: solid;
    border-color: #f0c56a;
}

QStatusBar#surfaceStatusBar QLabel#plotRiskLabel[riskLevel="danger"] {
    color: #b42318;
    background-color: #fff1f0;
    border-width: 1px;
    border-style: solid;
    border-color: #f3a7a0;
}

QStatusBar#surfaceStatusBar QWidget#computeProgressWidget {
    background-color: transparent;
    margin: 0 4px;
    min-width: 248px;
    max-width: 520px;
}

QStatusBar#surfaceStatusBar QLabel#computeProgressLabel {
    color: #4b5f78;
    font-size: 12px;
    font-weight: 600;
    /* Qt QSS: combined flag values in qproperty-* MUST be quoted. Unquoted
     * `A | B` fails the WHOLE application stylesheet parse (every widget
     * falls back to platform defaults) — guarded by
     * tests/ui_kit/test_stylesheet_parses.py. */
    qproperty-alignment: 'AlignVCenter | AlignLeft';
    /* Keep '%' clear of the rounded progress-bar tip (see ComputeProgressWidget
     * _SPACING / _TEXT_PAD). */
    padding-right: 6px;
}

QStatusBar#surfaceStatusBar QProgressBar#computeProgressBar {
    min-width: 160px;
    max-width: 160px;
    min-height: 8px;
    max-height: 8px;
    border: 1px solid #c9d8ea;
    border-radius: 4px;
    background-color: #eef4fb;
}

QStatusBar#surfaceStatusBar QProgressBar#computeProgressBar::chunk {
    border-radius: 4px;
    background-color: #1a7be8;
}

QStatusBar#surfaceStatusBar QToolButton#surfaceVersionButton {
    min-height: 22px;
    padding: 1px 7px;
    background-color: transparent;
    border: none;
    border-radius: 5px;
    color: #111827;
    font-weight: 700;
}

QStatusBar#surfaceStatusBar QToolButton#surfaceVersionButton:hover {
    background-color: #f5f7fb;
}

QStatusBar#surfaceStatusBar QToolButton#surfaceVersionButton:pressed {
    background-color: #eef2f7;
}

/* 软件说明 icon, left of the version/update affordance. */
QStatusBar#surfaceStatusBar QToolButton#surfaceHelpButton {
    min-height: 22px;
    padding: 1px 5px;
    background-color: transparent;
    border: none;
    border-radius: 5px;
}

QStatusBar#surfaceStatusBar QToolButton#surfaceHelpButton:hover {
    background-color: #f5f7fb;
}

QStatusBar#surfaceStatusBar QToolButton#surfaceHelpButton:pressed {
    background-color: #eef2f7;
}

/* Right-aligned '?  使用说明' link at the bottom of each analysis panel. */
QFrame#inspectorHelpRow {
    background: transparent;
}

QPushButton#inspectorHelpLink {
    background: transparent;
    border: none;
    padding: 2px 4px;
    color: #5b6472;
    font-size: 12px;
    text-align: right;
}

QPushButton#inspectorHelpLink:hover {
    color: #2563eb;
    text-decoration: underline;
}

QPushButton#inspectorHelpLink:pressed {
    color: #1d4ed8;
}

/* Version tag beside the status-bar update (cloud-download) icon. */
QStatusBar QLabel#versionTag {
    color: #8893a6;
    font-size: 11px;
    padding-right: 6px;
}

/* ============ Chart toolbar choice segments ============ */
QWidget#chartToolbar QPushButton[role="chart-choice"] {
    min-height: 22px;
    margin: 0 2px;
    padding: 2px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
    font-weight: 600;
}
QWidget#chartToolbar QPushButton[role="chart-choice"]:hover {
    background-color: transparent;
    color: {{CONTROL_TEXT}};
}
QWidget#chartToolbar QPushButton[role="chart-choice"]:checked {
    background-color: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}

QWidget#chartToolbar QWidget#chartTimeControlsSpacer {
    background-color: transparent;
}

QWidget#chartToolbar QWidget#chartFrequencyControlsSpacer {
    background-color: transparent;
}

QFrame#chartToolbarSep {
    margin-top: 6px;
    margin-bottom: 6px;
    margin-left: 12px;
    margin-right: 12px;
    background-color: #94a3b8;
    border: none;
}


QLabel#chartHint {
    padding: 0 12px;
    color: #374151;
    font-size: 12px;
    line-height: 14px;
    background-color: transparent;
}

QWidget#viewTabBar {
    background-color: transparent;
    border: none;
}

/* Quiet section identity (time / fft / fft_time / frf / order). Display-only:
 * soft icon badge + label + 1px rule, then a real gap before View tabs.
 * Matches the HTML option-B quiet anchor; no section rainbow / wash. */
QWidget#viewTabBar QWidget#viewSectionAnchor {
    background-color: transparent;
    border: none;
    margin: 0 4px 0 0;
}

QWidget#viewTabBar QLabel#viewSectionAnchorIcon {
    background-color: #e8f0ff;
    border: none;
    border-radius: 5px;
    padding: 0;
    margin: 0;
}

QWidget#viewTabBar QLabel#viewSectionAnchorLabel {
    background-color: transparent;
    border: none;
    color: #3d4f66;
    font-size: 12px;
    font-weight: 600;
    /* CJK line boxes keep empty descent below the glyph; 1px top pad drops
     * the ink onto the same midline as Latin "View N" in the tab. */
    padding: 1px 0 0 0;
    margin: 0;
}

QWidget#viewTabBar QFrame#viewSectionAnchorRule {
    background-color: #c8d2e0;
    border: none;
    margin: 0 0 0 2px;
    min-width: 1px;
    max-width: 1px;
}

QWidget#viewTabBar QTabBar#viewTabs {
    background-color: transparent;
}

/* Roomy density (default). NOTE these numbers do NOT decide when the bar
 * degrades: min-width 58px is a floor the real content clears anyway (a
 * "View 10" tab measures ~91px with its dot, padding and margins), so the
 * roomy/compact/overflow choice is made in ViewTabBar._sync_tabbar_width from
 * a measured sizeHint() against a measured row budget. */
QWidget#viewTabBar QTabBar#viewTabs::tab {
    min-width: 58px;
    height: 20px;
    margin: 3px 2px 1px 0;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 4px;
    background-color: transparent;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
}

/* Compact density — ViewTabBar._set_density sets density="compact" once the
 * roomy strip no longer fits the row. The label drops to the View's ordinal and
 * its full name moves into the tab tooltip, so this rule only trims the box.
 * Past 10 Views the dot colour is a secondary cue at best; the tooltip is the
 * only reliable way back to the name, which is why it is not optional. */
QWidget#viewTabBar QTabBar#viewTabs[density="compact"]::tab {
    min-width: 30px;
    padding: 0 5px;
}

QWidget#viewTabBar QTabBar#viewTabs::tab:hover {
    background-color: #eef4ff;
    border-color: #c7d7f2;
    color: #1f3b68;
}

QWidget#viewTabBar QTabBar#viewTabs::tab:selected {
    background-color: #e8f0ff;
    border-color: #a7bfea;
    border-bottom: 2px solid #2563eb;
    color: #173262;
}

/* Inline rename editor — floats over the tab on double-click. It MUST look
 * like the user is typing directly on the selected tab, NOT a separate white
 * popover box. Mirror the ::tab:selected chrome (tinted blue fill, soft blue
 * border, rounded corners) and match the tab's text metrics so the caret sits
 * where the label text is. The geometry is set in view_tabbar.py to cover the
 * tab's text region; padding here keeps the text horizontally aligned with the
 * label it replaces. */
QWidget#viewTabBar QLineEdit#viewTabRenameEditor {
    background-color: #e8f0ff;
    border: 1px solid #a7bfea;
    border-radius: 4px;
    padding: 0 9px;
    color: #173262;
    font-size: 12px;
    font-weight: 600;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QWidget#viewTabBar QPushButton#viewTabPlus {
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
    margin: 3px 0 1px 2px;
    padding: 0;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background-color: #ffffff;
    color: #1e293b;
    font-weight: 700;
}

QWidget#viewTabBar QPushButton#viewTabPlus:hover {
    background-color: #e8f0ff;
    border-color: #a7bfea;
    color: #173262;
}

/* Disabled = View count hit that manager's cap (ViewManager.max_views — 12 for
 * time domain, view_state.MAX_VIEWS for the analysis sections; do NOT hard-code
 * a number here). _update_plus_state already calls setEnabled(False); this rule
 * makes that visually obvious (greyed fill, edge and glyph) so the user sees the
 * cap rather than a still-bright button. */
QWidget#viewTabBar QPushButton#viewTabPlus:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #b8c2d0;
}

/* Overflow chevron "»N" — only on the row once the compact strip still cannot
 * fit, where N is how many tail Views were retired into its menu. Those tabs are
 * hidden with setTabVisible, never removeTab: the QTabBar index IS the
 * ViewManager index for switch/reorder/rename/context-menu, so removing tabs
 * would renumber all of them silently. Sized from its own label (no fixed width)
 * because _tabs_budget reserves the measured hint; it belongs to the fixed right
 * group with + and never compresses. */
QWidget#viewTabBar QPushButton#viewTabOverflow {
    min-height: 22px;
    max-height: 22px;
    margin: 3px 0 1px 2px;
    padding: 0 5px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background-color: #ffffff;
    color: #1e293b;
    font-size: 11px;
    font-weight: 700;
}

QWidget#viewTabBar QPushButton#viewTabOverflow:hover {
    background-color: #e8f0ff;
    border-color: #a7bfea;
    color: #173262;
}

/* Cancel-merge button (right side of the View tab bar).
 * The merge relation lives in the button tooltip/accessibility text, not as a
 * persistent status sentence. The button still needs an explicit QSS
 * background/border, otherwise the macOS native push-button bezel can render an
 * empty rounded box and the label disappears. */
QWidget#viewTabBar QLabel#viewSplitChip {
    color: #5a6478;
    padding: 0 6px;
    margin: 3px 0 1px 0;
}

QWidget#viewTabBar QPushButton#viewSplitClear {
    min-height: 22px;
    margin: 3px 2px 1px 0;
    padding: 0 10px;
    border: 1px solid #fb7185;
    border-radius: 5px;
    background-color: #fff1f2;
    color: #be123c;
    font-weight: 600;
}

QWidget#viewTabBar QPushButton#viewSplitClear:hover {
    background-color: #ffe4e6;
    border-color: #f43f5e;
    color: #9f1239;
}

QWidget#viewTabBar QPushButton#viewSplitClear:pressed {
    background-color: #fecdd3;
    border-color: #e11d48;
    color: #881337;
}

/* Bottom hint bar — sits beneath the canvas inside each chart card.
 * Two edge-anchored slots:
 *   #chartHintContext   (left edge, blue)  rotating gesture / context prompts
 *   #chartHintDiscovery (right edge, blue) "this exists" discovery prompts
 * The bar itself has a soft tinted backdrop and a hairline top edge so it
 * reads as a quiet status footer rather than another piece of toolbar. */
QFrame#chartHintBar {
    background-color: transparent;
    border-top: 1px solid #d3dbe6;
}
/* When docked into the rounded status bar, keep an opaque fill so a crushed
 * status message cannot peek as a glyph remnant to the left of ``?``. */
QStatusBar#surfaceStatusBar QFrame#chartHintBar {
    background-color: #ffffff;
    border-top: none;
}
QFrame#chartHintBar QToolButton#chartHintQuickrefButton {
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0;
    /* Clear the status-bar border-radius so the circle is not shaved. */
    margin: 0 4px 0 4px;
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    color: #1769e0;
    font-size: 11px;
    font-weight: 800;
}
QFrame#chartHintBar QToolButton#chartHintQuickrefButton:hover {
    background-color: #dbeafe;
    border-color: #60a5fa;
}
QFrame#chartHintBar QToolButton#chartHintQuickrefButton:pressed {
    background-color: #bfdbfe;
}
QFrame#chartHintBar QLabel#chartHintPersistent {
    color: #64748b;
    font-size: 11px;
    padding: 2px 8px;
    background-color: transparent;
}
QFrame#chartHintBar QLabel#chartHintContext {
    color: #2563eb;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    background-color: transparent;
}
QFrame#chartHintBar QLabel#chartHintDiscovery {
    color: #2563eb;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    background-color: transparent;
}

QWidget#timeViewBottomDock QFrame#chartHintBar {
    background-color: transparent;
    border-top: 1px solid #d3dbe6;
}

QWidget#timeViewBottomDock QFrame#chartHintBar QLabel#chartHintPersistent,
QWidget#timeViewBottomDock QFrame#chartHintBar QLabel#chartHintContext,
QWidget#timeViewBottomDock QFrame#chartHintBar QLabel#chartHintDiscovery {
    padding: 1px 6px;
}

QStatusBar QFrame#chartHintBar {
    background-color: transparent;
    border-top: none;
}

QStatusBar QFrame#chartHintBar QLabel#chartHintPersistent,
QStatusBar QFrame#chartHintBar QLabel#chartHintContext,
QStatusBar QFrame#chartHintBar QLabel#chartHintDiscovery {
    padding: 0 6px;
}

/* Collapsible side panels: transparent host; SidePanelStrip paints a
   white rounded pill and blue chevron in Python for crisp corners. */
QFrame#sidePanelStrip {
    background-color: transparent;
    border: none;
}
QFrame#sidePanelStrip[side="right"] {
    border: none;
}
QFrame#sidePanelStrip:hover {
    background-color: transparent;
}
QFrame#peekOverlay {
    background-color: #ffffff;
    border: 1px solid #d3d8df;
    border-radius: 10px;
}

/* Frame seams (Rule B): anchor the bottom bands so View tab + hint are not floating. */
QFrame#chartHintBar { border-top: 1px solid #d3dbe6; }
QWidget#viewTabBar { border: none; }

/* Central tray backdrop — the three rounded panels float on this. */
QWidget#centralTray { background-color: #f2f4f7; }

/* Acquisition review modal hierarchy (2026-07-08 G4). */
#reviewTitle {
    font-size: 15px;
    font-weight: 700;
}
#reviewFileName,
#reviewPreflight {
    color: #6b7280;
}

/* Saved-channel configuration manager: the approved HTML prototype is the
 * geometry and interaction reference. Keep this at the end so shared compact
 * defaults cannot inflate its 36px controls. */
QDialog#channelConfigManagerHtml {
    background-color: #ffffff;
    border: 1px solid #c8d4e3;
    border-radius: 12px;
}
QFrame#channelConfigHtmlHeader {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #dde5f0;
}
QLabel#channelConfigHtmlTitle { color: #172033; font-size: 21px; font-weight: 700; }
QLabel#channelConfigHtmlSubtitle { color: #697991; font-size: 12px; }
QLabel#channelConfigHtmlSummaryToken {
    padding: 5px 9px;
    border: 1px solid #d9e4f0;
    border-radius: 9px;
    background-color: #f8fbff;
    color: #536a87;
    font-size: 11px;
    font-weight: 600;
}
QWidget#channelConfigHtmlWorkspace { background-color: #ffffff; }
QFrame#channelConfigHtmlSidebar {
    background-color: #fbfcfe;
    border: none;
    border-right: 1px solid #dde5f0;
}
QFrame#channelConfigHtmlSideTools {
    background-color: #fbfcfe;
    border: none;
    border-bottom: 1px solid #dde5f0;
}
QLabel#channelConfigHtmlSideTitle { color: #172033; font-size: 13px; font-weight: 700; }
QLabel#channelConfigHtmlCountPill {
    min-width: 17px;
    padding: 2px 5px;
    border-radius: 8px;
    background-color: #e9f1fc;
    color: #38669e;
    font-family: "SF Mono", "Menlo", monospace;
    font-size: 11px;
    font-weight: 700;
}
QLineEdit#channelConfigHtmlConfigSearch,
QLineEdit#channelConfigHtmlChannelSearch,
QDialog#channelConfigHtmlRenameDialog QLineEdit,
QDialog#channelConfigHtmlImportDialog QComboBox {
    /* Flat manager chrome: 30px content + 1px borders = base 32px. */
    min-height: {{CONTROL_H_BASE_FLAT_CONTENT}};
    padding: 0 10px;
    border: 1px solid #c8d4e3;
    border-radius: 8px;
    background-color: #ffffff;
    color: #172033;
    font-size: 12px;
}
QLineEdit#channelConfigHtmlConfigSearch:focus,
QLineEdit#channelConfigHtmlChannelSearch:focus,
QDialog#channelConfigHtmlRenameDialog QLineEdit:focus,
QDialog#channelConfigHtmlImportDialog QComboBox:focus { border-color: #0a6de7; }
/* The base-track field family above is otherwise 8px, but a combo is a combo:
 * it rejoins the app-wide 7px so every dropdown matches. Keeps the height and
 * padding of its neighbours; only the corner defers to the combo family. */
QDialog#channelConfigHtmlImportDialog QComboBox { border-radius: 7px; }
QScrollArea#channelConfigHtmlConfigScroll { border: none; background-color: #fbfcfe; }
QWidget#channelConfigHtmlConfigList { background-color: #fbfcfe; }
QWidget#channelConfigHtmlConfigCopy { background-color: transparent; }
QFrame#channelConfigHtmlConfigRow {
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: transparent;
}
QFrame#channelConfigHtmlConfigRow:hover { background-color: #f2f6fb; }
QFrame#channelConfigHtmlConfigRow[active="true"] {
    border-color: #bfd7f7;
    border-left: 3px solid #0a6de7;
    background-color: #eaf3ff;
}
QLabel#channelConfigHtmlConfigName { color: #172033; font-size: 12px; font-weight: 700; }
QLabel#channelConfigHtmlConfigMeta { color: #697991; font-size: 10px; }
QLabel#channelConfigHtmlConfigCount {
    color: #60738b;
    font-family: "SF Mono", "Menlo", monospace;
    font-size: 10px;
    font-weight: 700;
}
QFrame#channelConfigHtmlSideFooter {
    border: none;
    border-top: 1px solid #dde5f0;
    background-color: #fbfcfe;
}

QFrame#channelConfigHtmlDetail { background-color: #ffffff; border: none; }
QFrame#channelConfigHtmlDetailHead {
    border: none;
    border-bottom: 1px solid #dde5f0;
    background-color: #ffffff;
}
QLabel#channelConfigHtmlDetailTitle { color: #172033; font-size: 18px; font-weight: 700; }
QLabel#channelConfigHtmlDetailMeta { color: #697991; font-size: 11px; }
QLabel#channelConfigHtmlDirtyDot { border: none; border-radius: 3px; background-color: #0a6de7; }
QFrame#channelConfigHtmlPreview {
    border: none;
    border-bottom: 1px solid #dde5f0;
    background-color: #fbfcff;
}
QLabel#channelConfigHtmlPreviewLabel { color: #43556c; font-size: 11px; font-weight: 700; }
QLabel#channelConfigHtmlMatchChip,
QLabel#channelConfigHtmlMissingChip {
    padding: 0 9px;
    border: 1px solid #c7e8d6;
    border-radius: 14px;
    background-color: #f2fbf6;
    color: #356650;
    font-size: 10px;
    font-weight: 700;
}
QLabel#channelConfigHtmlMissingChip {
    border-color: #f0d7aa;
    background-color: #fff7e7;
    color: #8a5609;
}
QLabel#channelConfigHtmlPreviewNote { color: #8291a5; font-size: 10px; }
QFrame#channelConfigHtmlChannelTools {
    border: none;
    border-bottom: 1px solid #dde5f0;
    background-color: #ffffff;
}
QFrame#channelConfigHtmlChannelArea { background-color: #ffffff; border: none; }
QFrame#channelConfigHtmlChannelHead {
    border: none;
    border-bottom: 1px solid #dde5f0;
    background-color: #f8fafc;
}
QLabel#channelConfigHtmlColumnHead { color: #697991; font-size: 10px; font-weight: 700; }
QTableWidget#channelConfigHtmlChannelTable {
    border: none;
    outline: none;
    background-color: #ffffff;
    color: #172033;
}
QTableWidget#channelConfigHtmlChannelTable::item {
    padding: 0 8px;
    border: none;
    border-bottom: 1px solid #edf1f6;
    background-color: #ffffff;
}
QTableWidget#channelConfigHtmlChannelTable::item:hover { background-color: #f8fbff; }
QWidget#channelConfigHtmlCheckCell[chosen="true"] { background-color: #edf5ff; }
QWidget#channelConfigHtmlRemoveCell[chosen="true"] { background-color: #edf5ff; }
QPushButton#channelConfigHtmlRemoveOne {
    min-width: 0;
    min-height: 0;
    padding: 0;
    border-color: transparent;
    border-radius: 8px;
    background-color: transparent;
    color: #d82c3b;
    font-size: 17px;
    font-weight: 500;
}
QPushButton#channelConfigHtmlRemoveOne:hover {
    border-color: #f1b8be;
    background-color: #fff2f3;
}
QLabel#channelConfigHtmlEmpty { padding: 18px; color: #8291a5; font-size: 12px; }
QFrame#channelConfigHtmlDetailFooter {
    border: none;
    border-top: 1px solid #dde5f0;
    background-color: #ffffff;
}
QLabel#channelConfigHtmlSaveState { color: #697991; font-size: 11px; }

QDialog#channelConfigManagerHtml QPushButton,
QDialog#channelConfigManagerHtml QToolButton {
    min-width: 0;
    /* Qt's CSS content height excludes the 1px top/bottom borders. */
    min-height: {{CONTROL_H_BASE_FLAT_CONTENT}};
    padding: 0 10px;
    border: 1px solid #c8d4e3;
    border-radius: 8px;
    background-color: #ffffff;
    color: #172033;
    font-size: 12px;
    font-weight: 700;
}
QDialog#channelConfigManagerHtml QPushButton:hover,
QDialog#channelConfigManagerHtml QToolButton:hover {
    border-color: #aebed1;
    background-color: #f8fbff;
}
QDialog#channelConfigManagerHtml QPushButton:disabled,
QDialog#channelConfigManagerHtml QToolButton:disabled {
    border-color: #e5eaf1;
    background-color: #f6f8fb;
    color: #a8b3c2;
}
QDialog#channelConfigManagerHtml QPushButton[role="primary"],
QDialog#channelConfigManagerHtml QToolButton[role="primary"] {
    border-color: {{CONTROL_ACCENT_BORDER}};
    background-color: {{CONTROL_ACCENT}};
    color: {{CONTROL_SURFACE_TOP}};
}
QDialog#channelConfigManagerHtml QPushButton[role="primary"]:hover,
QDialog#channelConfigManagerHtml QToolButton[role="primary"]:hover {
    border-color: {{CONTROL_ACCENT_DARK}};
    background-color: {{CONTROL_ACCENT_DARK}};
}
QPushButton#channelConfigHtmlDeleteConfig,
QPushButton#channelConfigHtmlDeleteConfigs,
QPushButton#channelConfigHtmlRemoveChannels {
    border-color: #f1b8be;
    background-color: #ffffff;
    color: #d82c3b;
}
QPushButton#channelConfigHtmlDeleteConfig:hover,
QPushButton#channelConfigHtmlDeleteConfigs:hover,
QPushButton#channelConfigHtmlRemoveChannels:hover { background-color: #fff2f3; }
QCheckBox#channelConfigHtmlCheck { spacing: 0; }
QCheckBox#channelConfigHtmlCheck::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #aebdce;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox#channelConfigHtmlCheck::indicator:checked {
    border-color: #0a6de7;
    background-color: #0a6de7;
    image: url("{{ICON_CHECKBOX_CHECKED}}");
}
QFrame#channelConfigHtmlToast {
    border: 1px solid #2a3f5b;
    border-radius: 9px;
    background-color: #1f2e44;
    color: #ffffff;
}
QFrame#channelConfigHtmlToast QLabel { color: #ffffff; font-size: 11px; }
QPushButton#channelConfigHtmlToastAction {
    min-width: 0;
    min-height: 0;
    padding: 0 6px;
    border: none;
    background-color: transparent;
    color: #bcd8ff;
    font-size: 11px;
}
QDialog#channelConfigHtmlRenameDialog,
QDialog#channelConfigHtmlImportDialog,
QDialog#channelConfigHtmlDiscardDialog {
    border: 1px solid #c8d4e3;
    border-radius: 12px;
    background-color: #ffffff;
}
QDialog#channelConfigHtmlRenameDialog QPushButton,
QDialog#channelConfigHtmlImportDialog QPushButton,
QDialog#channelConfigHtmlDiscardDialog QPushButton {
    min-height: {{CONTROL_H_BASE_FLAT_CONTENT}};
    padding: 0 10px;
    border: 1px solid #c8d4e3;
    border-radius: 8px;
    background-color: #ffffff;
    color: #172033;
    font-size: 12px;
    font-weight: 700;
}
QDialog#channelConfigHtmlRenameDialog QPushButton[role="primary"],
QDialog#channelConfigHtmlImportDialog QPushButton[role="primary"],
QDialog#channelConfigHtmlDiscardDialog QPushButton[role="primary"] {
    border-color: {{CONTROL_ACCENT_BORDER}};
    background-color: {{CONTROL_ACCENT}};
    color: {{CONTROL_SURFACE_TOP}};
}
QLabel#channelConfigHtmlPopoverTitle { color: #172033; font-size: 15px; font-weight: 700; }
QLabel#channelConfigHtmlPopoverCopy,
QLabel#channelConfigHtmlImportLabel { color: #697991; font-size: 11px; }
QLabel#channelConfigHtmlImportFile {
    padding: 10px;
    border: 1px solid #dde5f0;
    border-radius: 9px;
    background-color: #f7f9fc;
    color: #43556c;
    font-size: 11px;
}
QWidget#channelConfigHtmlImportStats { background-color: transparent; }
QFrame#channelConfigHtmlImportStat {
    border: 1px solid #dde5f0;
    border-radius: 8px;
    background-color: #ffffff;
}
QLabel#channelConfigHtmlImportStatValue {
    color: #172033;
    font-family: "SF Mono", "Menlo", monospace;
    font-size: 17px;
    font-weight: 700;
}
QLabel#channelConfigHtmlImportStatLabel { color: #697991; font-size: 10px; }
/* Must follow the generic dialog button rule above: the per-row removal
 * affordance is an icon-sized action, not a regular outlined button. */
QDialog#channelConfigManagerHtml QPushButton#channelConfigHtmlRemoveOne {
    min-width: 0;
    min-height: 0;
    max-height: 34px;
    padding: 0;
    border-color: transparent;
    border-radius: 8px;
    background-color: transparent;
    color: #d82c3b;
    font-size: 17px;
    font-weight: 500;
}
QDialog#channelConfigManagerHtml QPushButton#channelConfigHtmlRemoveOne:hover {
    border-color: #f1b8be;
    background-color: #fff2f3;
}

/* ============ Shared segmented-choice signature ============
 * The host owns the recessed track; segments reserve their border in every
 * state and only the checked segment becomes a raised white pill.  This is
 * intentionally placed after Inspector-local rules so a SegmentedChoice used
 * in that panel cannot fall back to the historic solid-blue choice styling. */
QFrame#segmentedChoice {
    border: 1px solid {{CONTROL_TRACK_LINE}};
    border-radius: 7px;
    background-color: {{CONTROL_TRACK}};
}
QFrame#segmentedChoice QPushButton[role="choice"] {
    /* 26px outer segment = 20px content + 2px padding × 2 + 1px border × 2. */
    min-height: 20px;
    padding: 2px 5px;
    border: 1px solid transparent;
    border-radius: 5px;
    background-color: transparent;
    color: {{CONTROL_TEXT_MUTED}};
    font-weight: 700;
}
QFrame#segmentedChoice QPushButton[role="choice"]:hover {
    background-color: transparent;
    border-color: transparent;
    color: {{CONTROL_TEXT}};
}
QFrame#segmentedChoice QPushButton[role="choice"]:checked {
    background-color: {{CONTROL_SURFACE_TOP}};
    border-color: {{CONTROL_SELECT_LINE}};
    color: {{CONTROL_TEXT_ON_SELECT}};
}

/* UltraView page */
QWidget#ultraViewPage {
    background-color: #f2f4f7;
}
QWidget#ultraViewLibrary,
QWidget#ultraViewBoardColumn,
QWidget#ultraViewBoardGrid,
QFrame#ultraViewUnplacedTray,
QFrame#ultraViewBoardToolbar,
QFrame#ultraViewCompareRail {
    background-color: #ffffff;
}
QWidget#ultraViewLibrary {
    border-right: 1px solid #d6e0eb;
}
QLabel#ultraViewLibraryTitle,
QLabel#ultraViewBoardName,
QLabel#ultraViewFocusTitle {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}
QLabel#ultraViewLibraryCount,
QLabel#ultraViewLibraryMeta,
QLabel#ultraViewLibrarySectionHead,
QLabel#ultraViewCardSource,
QLabel#ultraViewAxisWarning {
    color: #64748b;
    font-size: 11px;
}
QLineEdit#ultraViewLibrarySearch {
    border: 1px solid #d6e0eb;
    border-radius: 8px;
    background-color: #ffffff;
}
QFrame#ultraViewLibraryRow {
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: transparent;
}
QFrame#ultraViewLibraryRow:hover {
    background-color: #f5f8fc;
}
QFrame#ultraViewLibraryRow[selected="true"] {
    border-color: #bfd7f7;
    background-color: #edf5ff;
}
QFrame#ultraViewLibraryRow[onBoard="true"] {
    background-color: #f0f5fb;
}
QWidget#ultraViewCard {
    background-color: #ffffff;
    border: 1px solid #d6e0eb;
    border-radius: 10px;
}
QWidget#ultraViewCard[selected="true"] {
    border-color: #2d7ff9;
}
QWidget#ultraViewCard[replacementArmed="true"] {
    border-color: #2d7ff9;
    background-color: #f3f8ff;
}
QWidget#ultraViewCard[orphaned="true"] {
    border-color: #e2b15a;
}
QWidget#ultraViewCard[status="stale"] QLabel#ultraViewCardStatus {
    color: #8a5609;
}
QWidget#ultraViewCardHeader,
QWidget#ultraViewCardFooter {
    background-color: transparent;
}
QLabel#ultraViewCardImage {
    color: #64748b;
    padding: 8px;
}
QWidget#ultraViewEmptySlot {
    background-color: #f7fafc;
    border: 1px dashed #d6e0eb;
    border-radius: 10px;
    color: #64748b;
}
QWidget#ultraViewEmptySlot:hover {
    border-color: #2d7ff9;
    color: #2d7ff9;
    background-color: #f3f8ff;
}
QFrame#ultraViewUnplacedTray {
    border-top: 1px solid #d6e0eb;
}
QPushButton#ultraViewTrayTitle {
    border: none;
    border-radius: 0;
    background-color: #ffffff;
    color: #111827;
    font-weight: 700;
    text-align: left;
    padding: 6px 10px;
}
QFrame#ultraViewTrayItem {
    border: 1px solid #d6e0eb;
    border-radius: 8px;
    background-color: #ffffff;
}
QFrame#ultraViewCompareRail QPushButton#ultraViewCompareButton {
    min-height: 22px;
    padding: 2px 8px;
    border: 1px solid #d6e0eb;
    border-radius: 8px;
    background-color: #ffffff;
    color: #405269;
}
QFrame#ultraViewCompareRail QPushButton#ultraViewCompareButton:checked {
    border-color: #2d7ff9;
    background-color: #edf5ff;
    color: #1d4f9c;
}
QFrame#ultraViewFocusLayer {
    background-color: rgba(22, 33, 47, 140);
}
QFrame#ultraViewFocusPanel {
    background-color: #ffffff;
    border: 1px solid #d6e0eb;
    border-radius: 10px;
}
QPushButton#ultraViewOpenSourceButton {
    border: 1px solid #2d7ff9;
    border-radius: 8px;
    background-color: #2d7ff9;
    color: #ffffff;
    font-weight: 700;
    padding: 4px 10px;
}

