{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".\\.venv\\Scripts\\python.exe scripts\\lessons\\select.py --hook",
            "timeout": 10,
            "statusMessage": "Selecting relevant lessons"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".\\.venv\\Scripts\\python.exe scripts\\lessons\\check.py --post-tool-hook",
            "timeout": 10,
            "statusMessage": "Recording lesson signals"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".\\.venv\\Scripts\\python.exe scripts\\lessons\\check.py --hook",
            "timeout": 30,
            "statusMessage": "Checking lessons gate"
          }
        ]
      }
    ]
  }
}
